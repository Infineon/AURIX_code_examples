      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Pad configured in Tristate input mode or GPIO output mode"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Pad connected to alternative function 1 or input pull-down device"/>
