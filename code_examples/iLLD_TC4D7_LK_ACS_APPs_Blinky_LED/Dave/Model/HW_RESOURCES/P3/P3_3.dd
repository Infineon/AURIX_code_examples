  <provided xsi:type="ResourceModel:RegisterParameter" name="PADCFG9_GPIO" URI="http://resources/45.0.1/port/p/3/padcfg9_gpio" value="00000000" toolTipHelpDescription="Port GPIO Control Register for pin 9" defaultValue="00000000" addressOffset="0x00000390" resetValue="00000000" resetMask="0x00000000">
    <bitFields name="OUT" URI="http://resources/45.0.1/port/p/3/padcfg9_gpio/out" value="00000000" toolTipHelpDescription="Output value" defaultValue="00000000" startPos="0" stopPos="0" accessPermission="rh" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Set the input level of Pn.x to the low state."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Set the level of Pn.x to the high state."/>
    </bitFields>
    <bitFields name="SET" URI="http://resources/45.0.1/port/p/3/padcfg9_gpio/set" value="00000000" toolTipHelpDescription="Set" defaultValue="00000000" startPos="2" stopPos="2" accessPermission="w" maxValue="1" minValue="0"/>
    <bitFields name="CLR" URI="http://resources/45.0.1/port/p/3/padcfg9_gpio/clr" value="00000000" toolTipHelpDescription="Clear" defaultValue="00000000" startPos="3" stopPos="3" accessPermission="w" maxValue="1" minValue="0"/>
    <bitFields name="IN" URI="http://resources/45.0.1/port/p/3/padcfg9_gpio/in" value="00000000" toolTipHelpDescription="Read back Pin value" defaultValue="00000000" startPos="8" stopPos="8" accessPermission="rh" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="The input level of Pn.x is 0."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="The input level of Pn.x is 1."/>
    </bitFields>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="SET" URI="http://resources/45.0.1/port/p/3/padcfg9_gpio/set" value="00000000" toolTipHelpDescription="Set" defaultValue="00000000" startPos="2" stopPos="2" accessPermission="w" maxValue="1" minValue="0"/>
  <provided xsi:type="ResourceModel:BitField" name="CLR" URI="http://resources/45.0.1/port/p/3/padcfg9_gpio/clr" value="00000000" toolTipHelpDescription="Clear" defaultValue="00000000" startPos="3" stopPos="3" accessPermission="w" maxValue="1" minValue="0"/>
  <provided xsi:type="ResourceModel:RegisterParameter" name="PADCFG9_SAFSEC" URI="http://resources/45.0.1/port/p/3/padcfg9_safsec" value="00000000" toolTipHelpDescription="Port Pad Safety and Security Control Register for pad9" defaultValue="00000000" addressOffset="0x0000039C" resetValue="00000000" resetMask="0x00000000">
    <bitFields name="ESR_EN" URI="http://resources/45.0.1/port/p/3/padcfg9_safsec/esr_en" value="00000000" toolTipHelpDescription="Emergency Request Action Enable" defaultValue="00000000" startPos="0" stopPos="0" accessPermission="rwh" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Emergency stop function disabled. The output line remains connected (alternate function)."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Emergency stop function enabled. The mapped output function is disconnected and the safe state is entered by switching to input function with internal pull-up connected or tri-state, depending on the configured reset value of the corresponding Port CFG register through PMSWCR5.TRISTREQ or setting of HWCFG[6].(the content of the corresponding ESRx bit fields in register CFG will not be considered)."/>
    </bitFields>
    <bitFields name="ESR_PPL" URI="http://resources/45.0.1/port/p/3/padcfg9_safsec/esr_ppl" value="00000000" toolTipHelpDescription="Emergency status Push-Pull level" defaultValue="00000000" startPos="1" stopPos="1" accessPermission="rwh" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="The onput level of Pn.x is 0."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="The onput level of Pn.x is 1."/>
    </bitFields>
    <bitFields name="ESR_PD" URI="http://resources/45.0.1/port/p/3/padcfg9_safsec/esr_pd" value="00000000" toolTipHelpDescription="Emergency status Pad configuration" defaultValue="00000000" startPos="4" stopPos="5" accessPermission="rwh" maxValue="3" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="PAD in Push-PULL configuration when ESR is active. Level defined by field ESR_PPL"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Tristate, weak pull-up"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b10" description="Tristate, weak pull-down"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b11" description="Reserved - defaults to Tristate Pull Down"/>
    </bitFields>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="ESR_EN" URI="http://resources/45.0.1/port/p/3/padcfg9_safsec/esr_en" value="00000000" toolTipHelpDescription="Emergency Request Action Enable" defaultValue="00000000" startPos="0" stopPos="0" accessPermission="rwh" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Emergency stop function disabled. The output line remains connected (alternate function)."/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Emergency stop function enabled. The mapped output function is disconnected and the safe state is entered by switching to input function with internal pull-up connected or tri-state, depending on the configured reset value of the corresponding Port CFG register through PMSWCR5.TRISTREQ or setting of HWCFG[6].(the content of the corresponding ESRx bit fields in register CFG will not be considered)."/>
  </provided>
