      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b11" description="Pad connected to alternative function 3 or input tristate mode"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b100" description="Alternative Output function 4 selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1111" description="Alternative Output function 15 selected"/>
