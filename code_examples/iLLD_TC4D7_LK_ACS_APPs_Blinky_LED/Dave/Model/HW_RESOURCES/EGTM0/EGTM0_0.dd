    <bitFields name="TRIG_PULSE" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch12_ctrl/trig_pulse" value="00000000" toolTipHelpDescription="Trigger output pulse length of one cluster clock period" defaultValue="00000000" startPos="17" stopPos="17" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Output on # of instance 0, channel 12 is 1 as long as EGTM_CLS[0]_TOM_CH[12]_CN0.CN0 =EGTM_CLS[0]_TOM_CH[12]_SR0.SR0"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Output on # of instance 0, channel 12 is 1 for only one cluster clock period for EGTM_CLS[0]_TOM_CH[12]_CN0.CN0 =EGTM_CLS[0]_TOM_CH[12]_SR0.SR0"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Initial value, no function in this mode"/>
