    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Reset counter EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 to 0 on trigger TRIG_IN[0:0] or # [0:0]"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="OSM_TRIG" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/osm_trig" value="00000000" toolTipHelpDescription="One-shot pulse generation enabled by the selected trigger signal" defaultValue="00000000" startPos="21" stopPos="21" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Signal # [0:0] or # [0:0] cannot trigger start of single pulse generation"/>
