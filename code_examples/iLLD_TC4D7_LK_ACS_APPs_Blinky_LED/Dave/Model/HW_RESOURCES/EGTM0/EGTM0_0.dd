      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b111" description="Prohibited"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1000" description="Prohibited"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1001" description="Prohibited"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1010" description="Prohibited"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1011" description="Prohibited"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1100" description="Functional operation stopped, clock resolution tied to zero"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1101" description="# [x-1:x-1] selected"/>
