  <provided xsi:type="ResourceModel:RegisterParameter" name="CLS0_TOM_CH0_CTRL" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl" value="00000000" toolTipHelpDescription="TOM[0] channel [0] control register" defaultValue="00000000" addressOffset="0x00001000" resetValue="00000000" resetMask="0x00000000">
    <bitFields name="SR0_TRIG" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/sr0_trig" value="00000000" toolTipHelpDescription="EGTM_CLS[0]_TOM_CH[0]_SR0 is used to generate a trigger on output #[0:0] if equal to EGTM_CLS[0]_TOM_CH[0]_CN0." defaultValue="00000000" startPos="7" stopPos="7" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="EGTM_CLS[0]_TOM_CH[0]_SR0 is used as a shadow register for register EGTM_CLS[0]_TOM_CH[0]_CM0.CM0"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="EGTM_CLS[0]_TOM_CH[0]_SR0 is not used as a shadow register for register EGTM_CLS[0]_TOM_CH[0]_CM0.CM0. EGTM_CLS[0]_TOM_CH[0]_SR0 is compared with EGTM_CLS[0]_TOM_CH[0]_CN0 and if both are equal, a trigger pulse is generated at output # [0:0] ."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Initial value, no function in this mode"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Prohibited"/>
    </bitFields>
    <bitFields name="SL" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/sl" value="00000000" toolTipHelpDescription="Signal level for pulse width" defaultValue="00000000" startPos="11" stopPos="11" accessPermission="rwh" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Low signal level"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="High signal level"/>
    </bitFields>
    <bitFields name="CLK_SRC" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/clk_src" value="00000000" toolTipHelpDescription="Clock source select for channel" defaultValue="00000000" startPos="12" stopPos="15" accessPermission="rwh" maxValue="15" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="# [0:0] selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="# [1:1] selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b10" description="# [2:2] selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b11" description="# [3:3] selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b100" description="# [4:4] selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b101" description="Prohibited"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b110" description="Prohibited"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b111" description="Prohibited"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1000" description="Prohibited"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1001" description="Prohibited"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1010" description="Prohibited"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1011" description="Prohibited"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1100" description="Functional operation stopped, clock resolution tied to zero"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1101" description="# [x-1:x-1] selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1110" description="# [0:0] selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1111" description="Prohibited"/>
    </bitFields>
    <bitFields name="TRIG_PULSE" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/trig_pulse" value="00000000" toolTipHelpDescription="Trigger output pulse length of one cluster clock period" defaultValue="00000000" startPos="17" stopPos="17" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Output on # of instance 0, channel 0 is 1 as long as EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 =EGTM_CLS[0]_TOM_CH[0]_SR0.SR0"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Output on # of instance 0, channel 0 is 1 for only one cluster clock period for EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 =EGTM_CLS[0]_TOM_CH[0]_SR0.SR0"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Initial value, no function in this mode"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Prohibited"/>
    </bitFields>
    <bitFields name="UDMODE" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/udmode" value="00000000" toolTipHelpDescription="Up-down counter mode" defaultValue="00000000" startPos="18" stopPos="19" accessPermission="rw" maxValue="3" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Up-down counter mode disabled: EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 counts always up."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Up/down counter mode enabled: EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 counts up and down, EGTM_CLS[0]_TOM_CH[0]_CM0.CM0, EGTM_CLS[0]_TOM_CH[0]_CM1.CM1, EGTM_CLS[0]_TOM_CH[0]_CTRL.SL and EGTM_CLS[0]_TOM_CH[0]_CTRL.CLK_SRC are updated if EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 is 0 (i.e. the counting direction changes from down to up)."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b10" description="Up/down counter mode enabled: EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 counts up and down, EGTM_CLS[0]_TOM_CH[0]_CM0.CM0, EGTM_CLS[0]_TOM_CH[0]_CM1.CM1, EGTM_CLS[0]_TOM_CH[0]_CTRL.SL and EGTM_CLS[0]_TOM_CH[0]_CTRL.CLK_SRC are updated if EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 reaches EGTM_CLS[0]_TOM_CH[0]_CM0.CM0-1 or the channel receives the trigger signal.  and the counting direction changes from up to down."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b11" description="Up/down counter mode enabled: EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 counts up and down, EGTM_CLS[0]_TOM_CH[0]_CM0.CM0, EGTM_CLS[0]_TOM_CH[0]_CM1.CM1, EGTM_CLS[0]_TOM_CH[0]_CTRL.SL and EGTM_CLS[0]_TOM_CH[0]_CTRL.CLK_SRC are updated if EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 is 0 or reaches EGTM_CLS[0]_TOM_CH[0]_CM0.CM0-1 or the channel receives the trigger signal.  and the counting direction changes from up to down."/>
    </bitFields>
    <bitFields name="RST_CCU0" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/rst_ccu0" value="00000000" toolTipHelpDescription="Reset source of CCU0" defaultValue="00000000" startPos="20" stopPos="20" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Reset counter EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 to 0 on matching comparison EGTM_CLS[0]_TOM_CH[0]_CM0.CM0"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Reset counter EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 to 0 on trigger TRIG_IN[0:0] or # [0:0]"/>
    </bitFields>
    <bitFields name="OSM_TRIG" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/osm_trig" value="00000000" toolTipHelpDescription="One-shot pulse generation enabled by the selected trigger signal" defaultValue="00000000" startPos="21" stopPos="21" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Signal # [0:0] or # [0:0] cannot trigger start of single pulse generation"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Signal # [0:0] or # [0:0] can trigger start of single pulse generation (only if bit EGTM_CLS[0]_TOM_CH[0]_CTRL.OSM = 1)"/>
    </bitFields>
    <bitFields name="EXT_TRIG" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/ext_trig" value="00000000" toolTipHelpDescription="Select #[0:0] as trigger signal" defaultValue="00000000" startPos="22" stopPos="22" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="If EGTM_CLS[0]_TOM_CH[0]_CTRL.RST_CCU0 =1, signal # [0:0] is selected as trigger to reset EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 or to start single pulse generation"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="If EGTM_CLS[0]_TOM_CH[0]_CTRL.RST_CCU0 =1, signal # [0:0] is selected as trigger to reset EGTM_CLS[0]_TOM_CH[0]_CN0.CN0 or to start single pulse generation"/>
    </bitFields>
    <bitFields name="EXTTRIGOUT" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/exttrigout" value="00000000" toolTipHelpDescription="Select #[0:0] as potential output signal #[0:0]" defaultValue="00000000" startPos="23" stopPos="23" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Signal # [0:0] is selected as output on # [0:0] (if EGTM_CLS[0]_TOM_CH[0]_CTRL.TRIGOUT =0)"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Signal # [0:0] after synchronization to the selected CMU clock resolution is selected as output on # [0:0] (if EGTM_CLS[0]_TOM_CH[0]_CTRL.TRIGOUT = 0)"/>
    </bitFields>
    <bitFields name="TRIGOUT" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/trigout" value="00000000" toolTipHelpDescription="Trigger output selection (output signal #[0:0] ) of module TOM channel [0]" defaultValue="00000000" startPos="24" stopPos="24" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="# [0:0] is # [0:0] or # [0:0]"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="# [0:0] is #"/>
    </bitFields>
    <bitFields name="SPE_TRIG" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/spe_trig" value="00000000" toolTipHelpDescription="SPE trigger to reset EGTM_CLS[0]_TOM_CH[0]_CN0" defaultValue="00000000" startPos="25" stopPos="25" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Initial value, no function in this mode"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Prohibited"/>
    </bitFields>
    <bitFields name="OSM" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/osm" value="00000000" toolTipHelpDescription="One-shot mode." defaultValue="00000000" startPos="26" stopPos="26" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="One-shot mode disabled"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="One-shot mode enabled"/>
    </bitFields>
    <bitFields name="SPEM" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/spem" value="00000000" toolTipHelpDescription="SPE output mode enable for channel." defaultValue="00000000" startPos="28" stopPos="28" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="SPE output mode disabled: # [0:0] defined by TOM[0] channel [0] SOUR register"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="SPE output mode enabled: # [0:0] is defined by # [0:0]"/>
    </bitFields>
    <bitFields name="GCM" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/gcm" value="00000000" toolTipHelpDescription="Gated Counter Mode enable" defaultValue="00000000" startPos="29" stopPos="29" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Gated Counter Mode disabled"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Gated Counter Mode enabled"/>
    </bitFields>
    <bitFields name="FREEZE" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/freeze" value="00000000" toolTipHelpDescription="TOM[0] Freeze Mode enable" defaultValue="00000000" startPos="31" stopPos="31" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="A channel disable/enable may change internal register and output register"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="A channel enable/disable does not change an internal or output register but stops counter EGTM_CLS[0]_TOM_CH[0]_CN0.CN0"/>
    </bitFields>
