    <bitFields name="SR0_TRIG" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch12_ctrl/sr0_trig" value="00000000" toolTipHelpDescription="EGTM_CLS[0]_TOM_CH[12]_SR0 is used to generate a trigger on output #[12:12] if equal to EGTM_CLS[0]_TOM_CH[12]_CN0." defaultValue="00000000" startPos="7" stopPos="7" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="EGTM_CLS[0]_TOM_CH[12]_SR0 is used as a shadow register for register EGTM_CLS[0]_TOM_CH[12]_CM0.CM0"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="EGTM_CLS[0]_TOM_CH[12]_SR0 is not used as a shadow register for register EGTM_CLS[0]_TOM_CH[12]_CM0.CM0. EGTM_CLS[0]_TOM_CH[12]_SR0 is compared with EGTM_CLS[0]_TOM_CH[12]_CN0 and if both are equal, a trigger pulse is generated at output # [12:12] ."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Initial value, no function in this mode"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Prohibited"/>
    </bitFields>
    <bitFields name="SL" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch12_ctrl/sl" value="00000000" toolTipHelpDescription="Signal level for pulse width" defaultValue="00000000" startPos="11" stopPos="11" accessPermission="rwh" maxValue="1" minValue="0">
