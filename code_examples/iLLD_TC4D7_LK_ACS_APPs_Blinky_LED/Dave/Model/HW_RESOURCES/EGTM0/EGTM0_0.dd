  <provided xsi:type="ResourceModel:BitField" name="UDMODE" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch12_ctrl/udmode" value="00000000" toolTipHelpDescription="Up-down counter mode" defaultValue="00000000" startPos="18" stopPos="19" accessPermission="rw" maxValue="3" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Up-down counter mode disabled: EGTM_CLS[0]_TOM_CH[12]_CN0.CN0 counts always up."/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Up/down counter mode enabled: EGTM_CLS[0]_TOM_CH[12]_CN0.CN0 counts up and down, EGTM_CLS[0]_TOM_CH[12]_CM0.CM0, EGTM_CLS[0]_TOM_CH[12]_CM1.CM1, EGTM_CLS[0]_TOM_CH[12]_CTRL.SL and EGTM_CLS[0]_TOM_CH[12]_CTRL.CLK_SRC are updated if EGTM_CLS[0]_TOM_CH[12]_CN0.CN0 is 0 (i.e. the counting direction changes from down to up)."/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b10" description="Up/down counter mode enabled: EGTM_CLS[0]_TOM_CH[12]_CN0.CN0 counts up and down, EGTM_CLS[0]_TOM_CH[12]_CM0.CM0, EGTM_CLS[0]_TOM_CH[12]_CM1.CM1, EGTM_CLS[0]_TOM_CH[12]_CTRL.SL and EGTM_CLS[0]_TOM_CH[12]_CTRL.CLK_SRC are updated if EGTM_CLS[0]_TOM_CH[12]_CN0.CN0 reaches EGTM_CLS[0]_TOM_CH[12]_CM0.CM0-1 or the channel receives the trigger signal.  and the counting direction changes from up to down."/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b11" description="Up/down counter mode enabled: EGTM_CLS[0]_TOM_CH[12]_CN0.CN0 counts up and down, EGTM_CLS[0]_TOM_CH[12]_CM0.CM0, EGTM_CLS[0]_TOM_CH[12]_CM1.CM1, EGTM_CLS[0]_TOM_CH[12]_CTRL.SL and EGTM_CLS[0]_TOM_CH[12]_CTRL.CLK_SRC are updated if EGTM_CLS[0]_TOM_CH[12]_CN0.CN0 is 0 or reaches EGTM_CLS[0]_TOM_CH[12]_CM0.CM0-1 or the channel receives the trigger signal.  and the counting direction changes from up to down."/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="RST_CCU0" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch12_ctrl/rst_ccu0" value="00000000" toolTipHelpDescription="Reset source of CCU0" defaultValue="00000000" startPos="20" stopPos="20" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Reset counter EGTM_CLS[0]_TOM_CH[12]_CN0.CN0 to 0 on matching comparison EGTM_CLS[0]_TOM_CH[12]_CM0.CM0"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Reset counter EGTM_CLS[0]_TOM_CH[12]_CN0.CN0 to 0 on trigger TRIG_IN[12:12] or # [12:12]"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="OSM_TRIG" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch12_ctrl/osm_trig" value="00000000" toolTipHelpDescription="One-shot pulse generation enabled by the selected trigger signal" defaultValue="00000000" startPos="21" stopPos="21" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Signal # [12:12] or # [12:12] cannot trigger start of single pulse generation"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Signal # [12:12] or # [12:12] can trigger start of single pulse generation (only if bit EGTM_CLS[0]_TOM_CH[12]_CTRL.OSM = 1)"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="EXTTRIGOUT" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch12_ctrl/exttrigout" value="00000000" toolTipHelpDescription="Select #[12:12] as potential output signal #[12:12]" defaultValue="00000000" startPos="23" stopPos="23" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Signal # [12:12] is selected as output on # [12:12] (if EGTM_CLS[0]_TOM_CH[12]_CTRL.TRIGOUT =0)"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Signal # [12:12] after synchronization to the selected CMU clock resolution is selected as output on # [12:12] (if EGTM_CLS[0]_TOM_CH[12]_CTRL.TRIGOUT = 0)"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="TRIGOUT" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch12_ctrl/trigout" value="00000000" toolTipHelpDescription="Trigger output selection (output signal #[12:12] ) of module TOM channel [12]" defaultValue="00000000" startPos="24" stopPos="24" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="# [12:12] is # [12:12] or # [12:12]"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="# [12:12] is #"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="OSM" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch12_ctrl/osm" value="00000000" toolTipHelpDescription="One-shot mode." defaultValue="00000000" startPos="26" stopPos="26" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="One-shot mode disabled"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="One-shot mode enabled"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="FREEZE" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch12_ctrl/freeze" value="00000000" toolTipHelpDescription="TOM[0] Freeze Mode enable" defaultValue="00000000" startPos="31" stopPos="31" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="A channel disable/enable may change internal register and output register"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="A channel enable/disable does not change an internal or output register but stops counter EGTM_CLS[0]_TOM_CH[12]_CN0.CN0"/>
  </provided>
