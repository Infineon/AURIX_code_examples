  <provided xsi:type="ResourceModel:BitField" name="EXTTRIGOUT" URI="http://resources/45.0.2/peripheral/egtm/0/cls0_tom_ch0_ctrl/exttrigout" value="00000000" toolTipHelpDescription="Select #[0:0] as potential output signal #[0:0]" defaultValue="00000000" startPos="23" stopPos="23" accessPermission="rw" maxValue="1" minValue="0">
