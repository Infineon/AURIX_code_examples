    <bitFields name="EPR" URI="http://resources/0.0.8/peripheral/geth/0/gpctl/epr" value="00000000" toolTipHelpDescription="External Phy Interface RMII Mode Bit" defaultValue="00000000" startPos="22" stopPos="24" accessPermission="rw" maxValue="7" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="MII is selected and the divider (see 100B)is not active but the clock signals clk_tx_i and clk_rx_i are connected directly to the referring port pins"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="RGMII is selected. The clock signals are connected directly to the referring port pins"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b10" description="do not use!"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b11" description="do not use!"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b100" description="RMII is selected and an internal predivider divides the clock clk_rmii_i from pin ETHRXC by 2 or 20 and provides it to the internal signals clk_tx_i and clk_rx_i. The division factor depends from the signal mac_speed_o, controlled by bit FES in Register 0 (MAC Configuration Register)"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b101" description="do not use!"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b111" description="do not use!"/>
    </bitFields>
