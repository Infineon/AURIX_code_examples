			rArraygindexgroup_vlan_incl[i].gcheck_vlan_cfi.enabled = false				//TODO: remove this line when it's supported
			rArraygindexgroup_vlan_incl[i].ginteger_user_prio.enabled = false			//TODO: remove this line when it's supported
//TODO: uncomment when it's supported			rArraygindexgroup_vlan_incl[i].gcombo_add_vlan_inner_vlc.enabled = MF({
//TODO: uncomment when it's supported				(gindexcombo_sel_incl_cfg.value == "Inner VLAN Tag INCL #1") ||
//TODO: uncomment when it's supported				(gindexcombo_sel_incl_cfg.value == "Inner VLAN Tag INCL #2") ||
//TODO: uncomment when it's supported				(gindexcombo_sel_incl_cfg.value == "Inner VLAN Tag INCL #3") ||
//TODO: uncomment when it's supported				(gindexcombo_sel_incl_cfg.value == "Inner VLAN Tag INCL #4")
//TODO: uncomment when it's supported			}, Boolean)
			rArraygindexgroup_vlan_incl[i].gcombo_add_vlan_inner_vlc.enabled = false	//TODO: remove this line when it's supported
		}
		gindexcombo_sel_av_config.enabled = false                                       //TODO: remove this line when it's supported
		for (int index in 0..3)
		{
			int i = index
			rArraygindexgroup_av_tx_config[i].gcombo_en_av_algo.enabled = false			//TODO: remove this line when it's supported
			rArraygindexgroup_av_tx_config[i].gcheck_credit_ctrl.enabled = false		//TODO: remove this line when it's supported
			rArraygindexgroup_av_tx_config[i].gcombo_slt_cnt.enabled = false			//TODO: remove this line when it's supported
			rArraygindexgroup_av_tx_config[i].ginteger_snd_slope_cdt.enabled = false	//TODO: remove this line when it's supported
			rArraygindexgroup_av_tx_config[i].ginteger_high_crdt_value.enabled = false	//TODO: remove this line when it's supported
			rArraygindexgroup_av_tx_config[i].ginteger_low_crdt_value.enabled = false	//TODO: remove this line when it's supported
			rArraygindexgroup_av_tx_config[i].ginteger_snd_slope_cdt.maxValue =  MF({
				if (gcombo_speed.value == "1000Mbit/s")
				{
					return 8192
				}
				else
				{
					return 4096
				}
			}, Integer)
		}

		// Update Selection indexgroup based on number of queue/channel mentioned by the user
		gindexcombo_tx_queue_selection.options = MF({
			List<String> l = []
			for (int i = 1; i <= ginteger_no_tx_queue.value; i++)
			{
				l.add("TX QUEUE #" + i.toString())
			}
			return l
		}, List)

		gindexcombo_sel_mac_Address.options = MF({
			List<String> l = []
			for (int i = 0; i < ginteger_no_additional_mac.value; i++)
			{
				l.add("MAC Address #" + i.toString())
			}
			return l
		}, List)

		gindexcombo_rx_queue_sel.options = MF({
			List<String> l = []
			for (int i = 1; i <= ginteger_rx_no_queue.value; i++)
			{
				l.add("RX QUEUE #" + i.toString())
			}
			return l
		}, List)

		gindexcombo_sel_dma_tx_chn.options = MF({
			List<String> l = []
			for (int i = 0; i < ginteger_dma_tx_chn.value; i++)
			{
				l.add("TX DMA Channel #" + i.toString())
			}
			return l
		}, List)

		gindexcombo_dma_sel_rx_chn.options = MF({
			List<String> l = []
			for (int i = 0; i < ginteger_dma_no_rx_channel.value; i++)
			{
				l.add("RX DMA Channel #" + i.toString())
			}
			return l
		}, List)

		gindexcombo_sel_vlan_tag_filter.options = MF({
			List<String> l = []
			for (int i = 0; i < ginteger_mac_add_vlan_tag_filter.value; i++)
			{
				l.add("VLAN Tag Filter #" + i.toString())
			}
			return l
		}, List)

		gindexcombo_sel_av_config.options = MF({
			List<String> l = ["TX AV #1"]
			for (int i = 2; i <= ginteger_av_en.value; i++)
			{
				l.add("TX AV #" + i.toString())
			}
			return l
		}, List)

		if ((str_device == "TC375") || (str_device == "TC365") || (str_device == "TC364") || (str_device == "TC366"))
		{
			gcombo_mii_interface_mode.options = ["RMII"]
		}
		else
		{
			gcombo_mii_interface_mode.options = ["MII", "RMII", "RGMII"]
		}

		gcombo_speed.options = MF(
		{
			if (gcombo_mii_interface_mode.value == "RGMII")
			{
				return ["10Mbit/s","100Mbit/s", "1000Mbit/s"]
			}
			else if (gcombo_mii_interface_mode.value == "RMII")
			{
				return ["10Mbit/s","100Mbit/s"]
			}
			else
			{
				return ["10Mbit/s"]
			}
		}, List)
		
		gmessage_dma_info.text = MF({
		    StringBuilder msg_1 = new StringBuilder()
			
				Matcher matcher_0 = (rArraygindexgroup_dma_tx_config[0].gstring_dma_tx_callback.value =~ fn_regexp)
				Boolean ExpressionMatch_0 = !matcher_0.matches()
				Matcher matcher_1 = (rArraygindexgroup_dma_tx_config[1].gstring_dma_tx_callback.value =~ fn_regexp)
				Boolean ExpressionMatch_1 = !matcher_1.matches()
				Matcher matcher_2 = (rArraygindexgroup_dma_tx_config[2].gstring_dma_tx_callback.value =~ fn_regexp)
				Boolean ExpressionMatch_2 = !matcher_2.matches()
				Matcher matcher_3 = (rArraygindexgroup_dma_tx_config[3].gstring_dma_tx_callback.value =~ fn_regexp)
				Boolean ExpressionMatch_3 = !matcher_3.matches()
				if (ExpressionMatch_0 == true || ExpressionMatch_1 == true || ExpressionMatch_2 == true || ExpressionMatch_3 == true)
				{
					msg_1.append("Invalid function name in Tx DMA callback.")
				}
				 matcher_0 = (rArraygindexgroup_dma_rx_chn[0].gstring_dma_rx_callback.value =~ fn_regexp)
				 ExpressionMatch_0 = !matcher_0.matches()
				 matcher_1 = (rArraygindexgroup_dma_rx_chn[1].gstring_dma_rx_callback.value =~ fn_regexp)
				 ExpressionMatch_1 = !matcher_1.matches()
				 matcher_2 = (rArraygindexgroup_dma_rx_chn[2].gstring_dma_rx_callback.value =~ fn_regexp)
				 ExpressionMatch_2 = !matcher_2.matches()
				 matcher_3 = (rArraygindexgroup_dma_rx_chn[3].gstring_dma_rx_callback.value =~ fn_regexp)
				 ExpressionMatch_3 = !matcher_3.matches()
				 if (ExpressionMatch_0 == true || ExpressionMatch_1 == true || ExpressionMatch_2 == true || ExpressionMatch_3 == true)
				 {
					 msg_1.append("Invalid function name in Rx DMA callback.")
				 }
			return	msg_1.toString().trim() ?: ""
			}, String)
		
		gmessage_dma_info.visible = MF({gmessage_dma_info.text != ""}, Boolean)
		
		gmessage_info.text = MF({
			StringBuilder msg = new StringBuilder()
			if (gcombo_duplex_mode.value == "Full Duplex")
			{
				if (ginteger_mac_ipc.value != 40 && ginteger_mac_ipc.value != 80 && ginteger_mac_ipc.value != 88 )
				{
					if ((ginteger_mac_ipc.value < 96) || (ginteger_mac_ipc.value > 2144) || (((ginteger_mac_ipc.value - 96) % 8) != 0))
					{
						msg.append("Error: Invalid Inter Packet Gap. Valid values: 40, 80, 88, or 96-2144 in steps of 8. ")
					}
				}
			}
			if ((gcombo_mac_uffq.value == "RX QUEUE #4" && ginteger_rx_no_queue.value < 4) ||
				(gcombo_mac_uffq.value == "RX QUEUE #3" && ginteger_rx_no_queue.value < 3) ||
				(gcombo_mac_uffq.value == "RX QUEUE #2" && ginteger_rx_no_queue.value < 2) ||
				(gcombo_mac_mffq.value == "RX QUEUE #4" && ginteger_rx_no_queue.value < 4) ||
				(gcombo_mac_mffq.value == "RX QUEUE #3" && ginteger_rx_no_queue.value < 3) ||
				(gcombo_mac_mffq.value == "RX QUEUE #2" && ginteger_rx_no_queue.value < 2) ||
				(gcombo_mac_vffq.value == "RX QUEUE #4" && ginteger_rx_no_queue.value < 4) ||
				(gcombo_mac_vffq.value == "RX QUEUE #3" && ginteger_rx_no_queue.value < 3) ||
				(gcombo_mac_vffq.value == "RX QUEUE #2" && ginteger_rx_no_queue.value < 2))
			{
				msg.append("Hint: Please increase the number of RX QUEUE in MTL Configuration. ")
			}
			if (gcombo_duplex_mode.value == "Half Duplex" && ginteger_mac_ipc.value != 64)
			{
				if (msg.toString().isEmpty())
				{
					msg.append("Hint: ")
				}
				msg.append("Internal Packet Gap should be configured to 64 Bit times only.")
			}
			return	msg.toString().trim() ?: ""
		}, String)
		gmessage_info.visible = MF({gmessage_info.text != ""}, Boolean)
	}
	/* End   : APP Constructor */

	/* Begin : File Generation */
	def generateFiles()
	{
		generate("ethernet_config_confh.tmpl", "ethernet_config_conf.h")
		generate("ethernet_config_confc.tmpl", "ethernet_config_conf.c")
		copy("ethernet_config.c", "ethernet_config.c")
		copy("ethernet_config.h", "ethernet_config.h")
	}
	/* End   : File Generation */
}
