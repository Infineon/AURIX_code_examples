					l.add("VLAN Tag INCL #" + i.toString())
				}
			}
			else if (gcheck_double_vlan_process.value == true && gcheck_double_vlan_process.value == true)
			{
				for (int i = 1; i <= (ginteger_no_vlan_incl.value); i++)
