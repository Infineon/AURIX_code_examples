package Model.APPS.ETHERNET_CONFIG.v4_0_8;
// Import statements
import java.util.regex.Matcher

import ifx.davex.app.manifest.*
import ifx.davex.app.manifest.GString
/*************** Revision History **********************************************
 Version      Date          Description
 4.0.2        27-Feb-2026   - Initial version
 4.0.4        18-May-2026   - Refined the code to support LwIP
 4.0.6        26-May-2026	- Fixed the bug for LwIP
 4.0.8        02-Jul-2026	- Adapted to iLLD 1.22.0
 *******************************************************************************/

class  ETHERNET_CONFIG extends ETHERNET_CONFIG_GUI
{
	/* Note  : Following APP properties are mandatory and important */

	/* Begin : APP property section */

	/**
	 * APP version
	 * Format: a string with three digit separated by a dot.
	 */
	def version            = '4.0.8'

	/**
	 * APP categories declaration.
	 * It is list of strings. Subcategories are separated by slash.
	 * No limits on number of categories and subcategories depth.
	 */
	def categoriesDescription = ["Communication"]

	/**
	 * Minimum DAVE version required for this APP.
	 *
	 * It is string with three digit separated by a dot.
	 */
	def minDaveVersion           = '4.2.4'

	/**
	 * Keywords used by search feature in APPs selection view
	 *
	 * It is a list of string.
	 */
	def keywords      = ['GETH', 'Ethernet', 'IP', 'TCP', 'UDP']

	/**
	 * softwareIDs is used to declare which devices are compatible with this APP.
	 * It is a map with key a string containing a pattern that shall match the SW id of
	 * the device and as value the minimal version of the APP.
	 */

	def softwareIDs       = [
		"TC3.3.*.EXT":"1.0.0",
		"TC3.5.*.*":"1.0.0",
		"TC3.6.*.*":"1.0.0",
		"TC3.7.*.*":"1.0.0",
		"TC3.8.*.*":"1.0.0",
		"TC3.9.*.*":"1.0.0"]

	/**
	 * Singleton property:
	 * When it is true the APP can be instantiated only once.
	 */
	def singleton     = false

	/**
	 * initProvider property
	 * It shall be true to add a call to <AppName>_Init()
	 */
	def initProvider  = true

	/**
	 * Deprecated APP
	 * Set it to true to indicate that the APP shall be not used for new projects.
	 */
	def deprecated    = false

	/**
	 * Sharable property.
	 * It shall be true to allows multiple APPs to require the same instance of this APP.
	 */
	def sharable      = false

	/**
	 *  APP function description.
	 */
	def description = "The GETH module provides a high-speed Ethernet interface, enabling communication with other devices over a 10/100/1000Mbit/s. " + 
                        "It supports IEEE 802.3 standards for reliable and efficient data transfer."

	/* End   : APP property section */

	/* Begin : User APP property section */

	/* Required App */
	MRequiredApp appres_cpu							// CPU App
	MRequiredApp appres_clock                       // CLOCK App

	/*Required resource groups*/
	MVirtualResourceGroup hwres_geth				// GETH hardware resource
	MVirtualResourceGroup hwres_crs_pad				// Carrier sense(CRS)
	MVirtualResourceGroup hwres_crs_dv_pad			// Carrier sense-data valid(CRS_DV) pin
	MVirtualResourceGroup hwres_col_pad				// Collision detection pin for MII
	MVirtualResourceGroup hwres_rxer_pad			// Receive error for MII or RMII (optional)
	MVirtualResourceGroup hwres_rxd0_pad			// Receive data pin0 for MII or RMII or RGMII
	MVirtualResourceGroup hwres_rxd1_pad			// Receive data pin1 for MII or RMII or RGMII
	MVirtualResourceGroup hwres_rxd2_pad			// Receive data pin2 for MII or RGMII
	MVirtualResourceGroup hwres_rxd3_pad			// Receive data pin3 for MII or RGMII
	MVirtualResourceGroup hwres_txen_pad			// Transmit enable for MII or RMII
	MVirtualResourceGroup hwres_txer_pad			// Transmit error for MII
	MVirtualResourceGroup hwres_txd0_pad			// Transmit data pin0 for MII or RMII or RGMII
	MVirtualResourceGroup hwres_txd1_pad			// Transmit data pin1 for MII or RMII or RGMII
	MVirtualResourceGroup hwres_txd2_pad			// Transmit data pin2 for MII or RGMII
	MVirtualResourceGroup hwres_txd3_pad			// Transmit data pin3 for MII or RGMII
	MVirtualResourceGroup hwres_mdc_pad				// Station management clock pin
	MVirtualResourceGroup hwres_mdio_pad			// Station management data pin
	MVirtualResourceGroup hwres_ref_clk_pad			// Reference clock for RMII
	MVirtualResourceGroup hwres_tx_ctl_pad			// Tx Control for RGMII
	MVirtualResourceGroup hwres_rx_ctl_pad			// Rx Control for RGMII
	MVirtualResourceGroup hwres_rxc_pad				// RXc for RGMII or MII
	MVirtualResourceGroup hwres_txc_pad				// TXc for RGMII or MII
	MVirtualResourceGroup hwres_rx_dv_pad			// RX_DV for MII
	MVirtualResourceGroup hwres_gref_clk_pad		// GREF_CLK for RGMII
	MVirtualResourceGroup hwres_geth_itr			// GETH_ITR interrupt
	MVirtualResourceGroup hwres_dma_tx_0_itr		// TX0 DMA interrupt
	MVirtualResourceGroup hwres_dma_tx_1_itr		// TX1 DMA interrupt
	MVirtualResourceGroup hwres_dma_tx_2_itr		// TX2 DMA interrupt
	MVirtualResourceGroup hwres_dma_tx_3_itr		// TX3 DMA interrupt
	MVirtualResourceGroup hwres_dma_rx_0_itr		// RX0 DMA interrupt
	MVirtualResourceGroup hwres_dma_rx_1_itr		// RX1 DMA interrupt
	MVirtualResourceGroup hwres_dma_rx_2_itr		// RX2 DMA interrupt
	MVirtualResourceGroup hwres_dma_rx_3_itr		// RX3 DMA interrupt
	MVirtualResourceGroup hwres_prio_rx_0			// Priority of RX0 DMA interrupt
	MVirtualResourceGroup hwres_prio_rx_1			// Priority of RX1 DMA interrupt
	MVirtualResourceGroup hwres_prio_rx_2			// Priority of RX2 DMA interrupt
	MVirtualResourceGroup hwres_prio_rx_3			// Priority of RX3 DMA interrupt
	MVirtualResourceGroup hwres_cpu_prio_dma_tx0	// Priority of TX0 DMA interrupt
	MVirtualResourceGroup hwres_cpu_prio_dma_tx1	// Priority of TX1 DMA interrupt
	MVirtualResourceGroup hwres_cpu_prio_dma_tx2	// Priority of TX2 DMA interrupt
	MVirtualResourceGroup hwres_cpu_prio_dma_tx3	// Priority of TX3 DMA interrupt
	MVirtualResourceGroup hwres_cpu_prio_geth_intr	// Priority of GETH interrupt

	/*Required virtual signals*/
	MVirtualSignal vs_geth_crs						// CRS signal of GETH for MII interface
	MVirtualSignal vs_crs_pad						// CRS signal from port
	MVirtualSignal vs_geth_crs_dv					// CRS DV signal of GETH for RMII interface
	MVirtualSignal vs_crs_dv_pad					// CRS DV signal from port
	MVirtualSignal vs_geth_col						// COL signal of GETH for MII interface
	MVirtualSignal vs_col_pad						// COL signal from port
	MVirtualSignal vs_geth_rxer						// RXER signal of GETH for MII interface
	MVirtualSignal vs_rxer_pad						// RXER signal from port
	MVirtualSignal vs_geth_rxd0						// RXD0 signal of GETH
	MVirtualSignal vs_rxd0_pad						// RXD0 signal from port
	MVirtualSignal vs_geth_rxd1						// RXD1 signal of GETH
	MVirtualSignal vs_rxd1_pad						// RXD1 signal from port
	MVirtualSignal vs_geth_rxd2						// RXD2 signal of GETH for MII and RGMII interface
	MVirtualSignal vs_rxd2_pad						// RXD2 signal from port
	MVirtualSignal vs_geth_rxd3						// RXD3 signal of GETH for MII and RGMII interface
	MVirtualSignal vs_rxd3_pad						// RXD3 signal from port
	MVirtualSignal vs_geth_txen						// TXEN signal of GETH for MII and RMII interface
	MVirtualSignal vs_txen_pad						// TXEN signal from port
	MVirtualSignal vs_geth_txer						// TXER signal of GETH for MII interface
	MVirtualSignal vs_txer_pad						// TXER signal from port
	MVirtualSignal vs_geth_txd0						// TXD0 signal of GETH
	MVirtualSignal vs_txd0_pad						// TXD0 signal from port
	MVirtualSignal vs_geth_txd1						// TXD1 signal of GETH
	MVirtualSignal vs_txd1_pad						// TXD1 signal from port
	MVirtualSignal vs_geth_txd2						// TXD2 signal of GETH for MII and RGMII interface
	MVirtualSignal vs_txd2_pad						// TXD2 signal from port
	MVirtualSignal vs_geth_txd3						// TXD3 signal of GETH for MII and RGMII interface
	MVirtualSignal vs_txd3_pad						// TXD3 signal from port
	MVirtualSignal vs_geth_mdc						// MDC signal of GETH
	MVirtualSignal vs_mdc_pad						// MDC signal from port
	MVirtualSignal vs_geth_mdio						// Input MDIO signal of GETH
	MVirtualSignal vs_mdio_pad						// Input MDIO signal from port
	MVirtualSignal vs_geth_mdo						// Output MDO signal of GETH
	MVirtualSignal vs_mdo_pad						// Output MDO signal from port
	MVirtualSignal vs_geth_ref_clk					// REFCLK signal of GETH for RMII interface
	MVirtualSignal vs_ref_clk_pad					// REFCLK signal from port
	MVirtualSignal vs_geth_tx_ctl					// TXCTL signal of GETH for RGMII interface
	MVirtualSignal vs_tx_ctl_pad					// TXCTL signal from port
	MVirtualSignal vs_geth_rx_ctl					// RXCTL signal of GETH for RGMII interface
	MVirtualSignal vs_rx_ctl_pad					// RXCTL signal from port
	MVirtualSignal vs_geth_rxc						// RXC signal of GETH for MII and RGMII interface
	MVirtualSignal vs_rxc_pad						// RXC signal from port
	MVirtualSignal vs_geth_txc_in					// Input TXC signal of GETH for MII
	MVirtualSignal vs_geth_txc_out					// Output TXC signal of GETH for RGMII
	MVirtualSignal vs_txc_pad						// TXC signal from port
	MVirtualSignal vs_geth_rx_dv					// RXDV signal of GETH for MII interface
	MVirtualSignal vs_rx_dv_pad						// RXDV signal from port
	MVirtualSignal vs_geth_gref_clk					// GREFCLK signal of GETH for RGMII interface
	MVirtualSignal vs_gref_clk_pad					// GREFCLK signal from port
	MVirtualSignal vs_geth_itr_out					// Output interrupt signal to the CPU for Trigger0 signal
	MVirtualSignal vs_geth_itr_in					// Input interrupt signal to the interrupt for Trigger0 signal
	MVirtualSignal vs_geth_intr						// Interrupt signal for Trigger0 signal
	MVirtualSignal vs_dma_tx0_itr_out				// Output interrupt signal to the CPU for TX0 DMA signal
	MVirtualSignal vs_dma_tx0_itr_in				// Input interrupt signal to the interrupt for TX0 DMA signal
	MVirtualSignal vs_geth_dma_tx0_itr_out			// Interrupt signal for Trigger2 signal
	MVirtualSignal vs_cpu_prio_dma_tx0_global		// Virtual signal for TX0 DMA interrupt priority configuration and CPU core
	MVirtualSignal vs_dma_tx1_itr_out				// Output interrupt signal to the CPU for TX1 DMA signal
	MVirtualSignal vs_dma_tx1_itr_in				// Input interrupt signal to the interrupt for TX1 DMA signal
	MVirtualSignal vs_geth_dma_tx1_itr_out			// Interrupt signal for Trigger3 signal
	MVirtualSignal vs_cpu_prio_dma_tx1_global		// Virtual signal for TX1 DMA interrupt priority configuration and CPU core
	MVirtualSignal vs_dma_tx2_itr_out				// Output interrupt signal to the CPU for TX2 DMA signal
	MVirtualSignal vs_dma_tx2_itr_in				// Input interrupt signal to the interrupt for TX2 DMA signal
	MVirtualSignal vs_geth_dma_tx2_itr_out			// Interrupt signal for Trigger4 signal
	MVirtualSignal vs_cpu_prio_dma_tx2_global		// Virtual signal for TX2 DMA interrupt priority configuration and CPU core
	MVirtualSignal vs_dma_tx3_itr_out				// Output interrupt signal to the CPU for TX3 DMA signal
	MVirtualSignal vs_dma_tx3_itr_in				// Input interrupt signal to the interrupt for TX3 DMA signal
	MVirtualSignal vs_geth_dma_tx3_itr_out			// Interrupt signal for Trigger5 signal
	MVirtualSignal vs_cpu_prio_dma_tx3_global		// Virtual signal for TX3 DMA interrupt priority configuration and CPU core
	MVirtualSignal vs_dma_rx0_itr_out				// Output interrupt signal to the CPU for RX0 DMA signal
	MVirtualSignal vs_dma_rx0_itr_in				// Input interrupt signal to the interrupt for RX0 DMA signal
	MVirtualSignal vs_dma_rx0_itr_global			// Virtual signal for RX0 DMA interrupt priority configuration and CPU core
	MVirtualSignal vs_geth_dma_rx0_itr_out			// Interrupt signal for Trigger6 signal
	MVirtualSignal vs_dma_rx1_itr_out				// Output interrupt signal to the CPU for RX1 DMA signal
	MVirtualSignal vs_dma_rx1_itr_in				// Input interrupt signal to the interrupt for RX1 DMA signal
	MVirtualSignal vs_dma_rx1_itr_global			// Virtual signal for RX1 DMA interrupt priority configuration and CPU core
	MVirtualSignal vs_geth_dma_rx1_itr_out			// Interrupt signal for Trigger7 signal
	MVirtualSignal vs_dma_rx2_itr_out				// Output interrupt signal to the CPU for RX2 DMA signal
	MVirtualSignal vs_dma_rx2_itr_in				// Input interrupt signal to the interrupt for RX2 DMA signal
	MVirtualSignal vs_dma_rx2_itr_global			// Virtual signal for RX2 DMA interrupt priority configuration and CPU core
	MVirtualSignal vs_geth_dma_rx2_itr_out			// Interrupt signal for Trigger8 signal
	MVirtualSignal vs_dma_rx3_itr_out				// Output interrupt signal to the CPU for RX3 DMA signal
	MVirtualSignal vs_dma_rx3_itr_in				// Input interrupt signal to the interrupt for RX3 DMA signal
	MVirtualSignal vs_dma_rx3_itr_global			// Virtual signal for RX3 DMA interrupt priority configuration and CPU core
	MVirtualSignal vs_geth_dma_rx3_itr_out			// Interrupt signal for Trigger9 signal
	MVirtualSignal vs_cpu_prio_geth_intr_global		// Virtual signal for GETH interrupt priority configuration and CPU core
	MVirtualSignalRA vs_cpu_core_global				// Referring the signal of CPU_CORE

	GString gstring_cpu_value = GString()           // CPU core number

	/* End   : User APP property section */

	/* Begin : APP Constructor */
	public ETHERNET_CONFIG(DaveEnv daveEnv)
	{
		String str_device = (daveEnv.project.selectedDevice.deviceId.softwareId.split("\\.")[0]
			+ daveEnv.project.selectedDevice.deviceId.softwareId.split("\\.")[1]
			+ daveEnv.project.selectedDevice.deviceId.softwareId.split("\\.")[2]) /* ex:TC375 */
		MF is_phy_rmii = MF({gcombo_mii_interface_mode.value == "RMII"}, Boolean)
		MF is_phy_rgmii = MF({gcombo_mii_interface_mode.value == "RGMII"}, Boolean)
		MF is_phy_mii = MF({gcombo_mii_interface_mode.value == "MII"}, Boolean)
		MF is_phy_mii_rmii = MF({gcombo_mii_interface_mode.value == "MII" || gcombo_mii_interface_mode.value == "RMII"}, Boolean)
		MF is_phy_mii_rgmii = MF({gcombo_mii_interface_mode.value == "MII" || gcombo_mii_interface_mode.value == "RGMII"}, Boolean)
		MF is_interrupt_on	= MF({true}, Boolean)
		MF is_mac_dma_enabled = MF({gcheck_mac_en_dma.value}, Boolean)
		MF is_mac_dma_disbaled = MF({gcheck_mac_en_dma.value == false}, Boolean)
		MF is_full_duplex = MF({gcombo_duplex_mode.value == "Full Duplex"}, Boolean)
		MF is_vlan_tag_enabled = MF({gcheck_vlan_tag_en.value}, Boolean)
		MF is_double_vlan = MF({gcheck_double_vlan_process.value}, Boolean)
		MF is_dma_tx_1_en = MF({ginteger_dma_tx_chn.value >= 2}, Boolean)
		MF is_dma_tx_2_en = MF({ginteger_dma_tx_chn.value >= 3}, Boolean)
		MF is_dma_tx_3_en = MF({ginteger_dma_tx_chn.value >= 4}, Boolean)
		MF is_dma_rx_1_en = MF({ginteger_dma_no_rx_channel.value >= 2}, Boolean)
		MF is_dma_rx_2_en = MF({ginteger_dma_no_rx_channel.value >= 3}, Boolean)
		MF is_dma_rx_3_en = MF({ginteger_dma_no_rx_channel.value >= 4}, Boolean)
		MF is_receive_all = MF({gcheck_receive_all.value}, Boolean)
		/* Regular expression to check callback function name is valid or not */
		String fn_regexp = ~/^[^\d\W]\w*\Z/

		/*------------------------------------------------------------------------------------------------------------------------------------------*/
		/*								 Required APP																								*/
		/*------------------------------------------------------------------------------------------------------------------------------------------*/
		appres_cpu = MRequiredApp("CPU_CORE", "CPU_CORE APP", RSHARABLE, "4.0.2")
		appres_clock = MRequiredApp("CLOCK", "CLOCK APP", RSHARABLE, "4.0.4")

		/*------------------------------------------------------------------------------------------------------------------------------------------*/
		/*							  Hardware resource consumption block																			*/
		/*------------------------------------------------------------------------------------------------------------------------------------------*/
		gstring_cpu_value.value = MF({appres_cpu.getVal(["gstring_core", "value"])}, String)
		hwres_geth = MVirtualResourceGroup("Module", ["peripheral", "geth", "*", "geth"])

		hwres_crs_pad = MVirtualResourceGroup("Carrier Sense Signal pin", ["port", "p", "*", "pad", "*"], is_phy_mii)
		vs_geth_crs = MVirtualSignal(hwres_geth, "CRS", "crs", is_phy_mii, false)
		@AddPin(pinDisplayName = 'CRS pin')
		vs_crs_pad = MVirtualSignal(hwres_crs_pad, "CRS pin", "pad", is_phy_mii, false)
		addConnectionConstraint(vs_crs_pad, vs_geth_crs, is_phy_mii)

		hwres_crs_dv_pad = MVirtualResourceGroup("Carrier Sense / Data Valid pin", ["port", "p", "*", "pad", "*"], is_phy_rmii)
		vs_geth_crs_dv = MVirtualSignal(hwres_geth, "CRSDV", "crsdv", is_phy_rmii, false)
		@AddPin(pinDisplayName = 'CRS DV pin')
		vs_crs_dv_pad = MVirtualSignal(hwres_crs_dv_pad, "CRS DV pin", "pad", is_phy_rmii, false)
		addConnectionConstraint(vs_crs_dv_pad, vs_geth_crs_dv, is_phy_rmii)

		vs_cpu_core_global = MVirtualSignalRA(appres_cpu, "vs_cpu_core_global")

		hwres_geth_itr = MVirtualResourceGroup("GETH Interrupt SRN", ["peripheral", "int", "0", "srn", "*"])
		vs_geth_intr = MVirtualSignal(hwres_geth, "INT", "trigo1", true, false)
		vs_geth_itr_in = MVirtualSignal(hwres_geth_itr, "INT req", "in", true, false)
		vs_geth_itr_out	 = MVirtualSignal(hwres_geth_itr, "INT", "out", true, false)
		addConnectionConstraint(vs_geth_intr, vs_geth_itr_in, true)

		hwres_cpu_prio_geth_intr = MVirtualResourceGroup("GETH Interrupt", ["peripheral", "cpu", "*", "prio", "*"], true)
		vs_cpu_prio_geth_intr_global = MVirtualSignal(hwres_cpu_prio_geth_intr, "global", "global", true, false)
		addConnectionConstraint(vs_geth_itr_out, vs_cpu_core_global, true)
		addConnectionConstraint(vs_cpu_core_global, vs_cpu_prio_geth_intr_global, true)

		hwres_dma_tx_0_itr = MVirtualResourceGroup("TX DMA0 Interrupt SRN", ["peripheral", "int", "0", "srn", "*"], true)
		vs_geth_dma_tx0_itr_out = MVirtualSignal(hwres_geth, "TXDMA_INT", "trigo2", true, false)
		vs_dma_tx0_itr_in = MVirtualSignal(hwres_dma_tx_0_itr, "TXDMA_INT req", "in", true, false)
		vs_dma_tx0_itr_out = MVirtualSignal(hwres_dma_tx_0_itr, "TXDMA_INT", "out", true, false)
		addConnectionConstraint(vs_geth_dma_tx0_itr_out, vs_dma_tx0_itr_in, true)

		hwres_cpu_prio_dma_tx0 = MVirtualResourceGroup("TX DMA0 Interrupt", ["peripheral", "cpu", "*", "prio", "*"], true)
		vs_cpu_prio_dma_tx0_global = MVirtualSignal(hwres_cpu_prio_dma_tx0, "global", "global", true, false)

		addConnectionConstraint(vs_dma_tx0_itr_out, vs_cpu_core_global, true)
		addConnectionConstraint(vs_cpu_core_global, vs_cpu_prio_dma_tx0_global, true)

		hwres_dma_tx_1_itr = MVirtualResourceGroup("TX DMA1 Interrupt SRN", ["peripheral", "int", "0", "srn", "*"], is_dma_tx_1_en)
		vs_geth_dma_tx1_itr_out = MVirtualSignal(hwres_geth, "TXDMA_INT", "trigo3", is_dma_tx_1_en, false)
		vs_dma_tx1_itr_in = MVirtualSignal(hwres_dma_tx_1_itr, "TXDMA_INT req", "in", is_dma_tx_1_en, false)
		vs_dma_tx1_itr_out = MVirtualSignal(hwres_dma_tx_1_itr, "TXDMA_INT", "out", is_dma_tx_1_en, false)
		addConnectionConstraint(vs_geth_dma_tx1_itr_out, vs_dma_tx1_itr_in, is_dma_tx_1_en)

		hwres_cpu_prio_dma_tx1 = MVirtualResourceGroup("TX DMA1 Interrupt", ["peripheral", "cpu", "*", "prio", "*"], is_dma_tx_1_en)
		vs_cpu_prio_dma_tx1_global = MVirtualSignal(hwres_cpu_prio_dma_tx1, "global", "global", is_dma_tx_1_en, false)

		addConnectionConstraint(vs_dma_tx1_itr_out, vs_cpu_core_global, is_dma_tx_1_en)
		addConnectionConstraint(vs_cpu_core_global, vs_cpu_prio_dma_tx1_global, is_dma_tx_1_en)

		hwres_dma_tx_2_itr = MVirtualResourceGroup("TX DMA2 Interrupt SRN", ["peripheral", "int", "0", "srn", "*"], is_dma_tx_2_en)
		vs_geth_dma_tx2_itr_out = MVirtualSignal(hwres_geth, "TXDMA_INT", "trigo4", is_dma_tx_2_en, false)
		vs_dma_tx2_itr_in = MVirtualSignal(hwres_dma_tx_2_itr, "TXDMA_INT req", "in", is_dma_tx_2_en, false)
		vs_dma_tx2_itr_out = MVirtualSignal(hwres_dma_tx_2_itr, "TXDMA_INT", "out", is_dma_tx_2_en, false)
		addConnectionConstraint(vs_geth_dma_tx2_itr_out, vs_dma_tx2_itr_in, is_dma_tx_2_en)

		hwres_cpu_prio_dma_tx2 = MVirtualResourceGroup("TX DMA2 Interrupt", ["peripheral", "cpu", "*", "prio", "*"], is_dma_tx_2_en)
		vs_cpu_prio_dma_tx2_global = MVirtualSignal(hwres_cpu_prio_dma_tx2, "global", "global", is_dma_tx_2_en, false)

		addConnectionConstraint(vs_dma_tx2_itr_out, vs_cpu_core_global, is_dma_tx_2_en)
		addConnectionConstraint(vs_cpu_core_global, vs_cpu_prio_dma_tx2_global, is_dma_tx_2_en)

		hwres_dma_tx_3_itr = MVirtualResourceGroup("TX DMA3 Interrupt SRN", ["peripheral", "int", "0", "srn", "*"], is_dma_tx_3_en)
		vs_geth_dma_tx3_itr_out = MVirtualSignal(hwres_geth, "TXDMA_INT", "trigo5", is_dma_tx_3_en, false)
		vs_dma_tx3_itr_in = MVirtualSignal(hwres_dma_tx_3_itr, "TXDMA_INT req", "in", is_dma_tx_3_en, false)
		vs_dma_tx3_itr_out = MVirtualSignal(hwres_dma_tx_3_itr, "TXDMA_INT", "out", is_dma_tx_3_en, false)
		addConnectionConstraint(vs_geth_dma_tx3_itr_out, vs_dma_tx3_itr_in, is_dma_tx_3_en)

		hwres_cpu_prio_dma_tx3 = MVirtualResourceGroup("TX DMA3 Interrupt", ["peripheral", "cpu", "*", "prio", "*"], is_dma_tx_3_en)
		vs_cpu_prio_dma_tx3_global = MVirtualSignal(hwres_cpu_prio_dma_tx3, "global", "global", is_dma_tx_3_en, false)

		addConnectionConstraint(vs_dma_tx3_itr_out, vs_cpu_core_global, is_dma_tx_3_en)
		addConnectionConstraint(vs_cpu_core_global, vs_cpu_prio_dma_tx3_global, is_dma_tx_3_en)

		hwres_dma_rx_0_itr = MVirtualResourceGroup("RX DMA0 Interrupt SRN", ["peripheral", "int", "0", "srn", "*"], is_interrupt_on)
		vs_geth_dma_rx0_itr_out = MVirtualSignal(hwres_geth, "RXDMA_INT", "trigo6", is_interrupt_on, false)
		vs_dma_rx0_itr_in = MVirtualSignal(hwres_dma_rx_0_itr, "RXDMA_INT req", "in", is_interrupt_on, false)
		vs_dma_rx0_itr_out = MVirtualSignal(hwres_dma_rx_0_itr, "RXDMA_INT", "out", is_interrupt_on, false)
		addConnectionConstraint(vs_geth_dma_rx0_itr_out, vs_dma_rx0_itr_in, is_interrupt_on)

		hwres_prio_rx_0 = MVirtualResourceGroup("RX DMA0 Interrupt", ["peripheral", "cpu", "*", "prio", "*"], is_interrupt_on)
		vs_dma_rx0_itr_global = MVirtualSignal(hwres_prio_rx_0, "global", "global", is_interrupt_on, false)

		addConnectionConstraint(vs_dma_rx0_itr_out, vs_cpu_core_global, is_interrupt_on)
		addConnectionConstraint(vs_cpu_core_global, vs_dma_rx0_itr_global, is_interrupt_on)

