package Model.APPS.ETHERNET_CONFIG.v4_0_8;
import ifx.davex.app.manifest.*;

class Gindexgroup_rx_queue_config{
	 public GLabel glabel_rx_queue_sel;
	 public GLabel glabel_rx_store_fwd;
	 public GCheck gcheck_rx_store_fwd;
	 public GLabel glabel_rx_queue_size;
	 public GCombo gcombo_rx_queue_size;
	 public GLabel glabel_mtl_rxq_wegt;
	 public GInteger ginteger_mtl_rxq_wegt;
	 public GLabel glabel_mtl_rxq_frm_arbit;
	 public GCheck gcheck_mtl_rxq_frm_arbit;
	 public GLabel glabel_rx_overflow_int_en;
	 public GCheck gcheck_rx_overflow_int_en;
	 public GLabel glabel_fwd_err_pkt;
	 public GCheck gcheck_fwd_err_pkt;
	 public GLabel glabel_fwd_undersize_pkt;
	 public GCheck gcheck_fwd_undersize_pkt;
	 public GLabel glabel_rx_dma_channel_map;
	 public GCombo gcombo_rx_dma_channel_map;

	public Gindexgroup_rx_queue_config (DaveEnv daveEnv, String widgetName,int index){
	 glabel_rx_queue_sel = new GLabel(widgetName: "glabel_rx_queue_sel", text: "Select RX Queue to Configure", enabled: true, visible: true, parentWidgetName:widgetName)
	 glabel_rx_store_fwd = new GLabel(widgetName: "glabel_rx_store_fwd", text: "Store and Forward", enabled: true, visible: true, parentWidgetName:widgetName)
	 gcheck_rx_store_fwd = new GCheck(widgetName: "gcheck_rx_store_fwd", value: false, enabled: true, visible: true, parentWidgetName:widgetName)
	 glabel_rx_queue_size = new GLabel(widgetName: "glabel_rx_queue_size", text: "Queue Size", enabled: true, visible: true, parentWidgetName:widgetName)
	 gcombo_rx_queue_size = new GCombo(widgetName: "gcombo_rx_queue_size", options: ["256 Bytes","512 Bytes","768 Bytes","1024 Bytes","1280 Bytes","1536 Bytes","1792 Bytes","2048 Bytes","2304 Bytes","2560 Bytes","2816 Bytes","3072 Bytes","3328 Bytes","3584 Bytes","3840 Bytes","4096 Bytes","4352 Bytes","4608 Bytes","4864 Bytes","5120 Bytes","5376 Bytes","5632 Bytes","5888 Bytes","6144 Bytes","6400 Bytes","6656 Bytes","6912 Bytes","7168 Bytes","7424 Bytes","7680 Bytes","7936 Bytes","8192 Bytes"], value: "256 Bytes", enabled: true, visible: true, isMandatoryValue: false, parentWidgetName:widgetName)
	 glabel_mtl_rxq_wegt = new GLabel(widgetName: "glabel_mtl_rxq_wegt", text: "Queue Weight", enabled: true, visible: true, parentWidgetName:widgetName)
	 ginteger_mtl_rxq_wegt = new GInteger(widgetName: "ginteger_mtl_rxq_wegt", value: 0, minValue: 0, maxValue: 7, enabled: true, visible: true, isMandatoryValue: false, parentWidgetName:widgetName)
	 glabel_mtl_rxq_frm_arbit = new GLabel(widgetName: "glabel_mtl_rxq_frm_arbit", text: "Packet Arbitration Mode", enabled: true, visible: true, parentWidgetName:widgetName)
	 gcheck_mtl_rxq_frm_arbit = new GCheck(widgetName: "gcheck_mtl_rxq_frm_arbit", value: false, enabled: true, visible: true, parentWidgetName:widgetName)
	 glabel_rx_overflow_int_en = new GLabel(widgetName: "glabel_rx_overflow_int_en", text: "Overflow Interrupt Enabled", enabled: true, visible: true, parentWidgetName:widgetName)
	 gcheck_rx_overflow_int_en = new GCheck(widgetName: "gcheck_rx_overflow_int_en", value: false, enabled: true, visible: true, parentWidgetName:widgetName)
	 glabel_fwd_err_pkt = new GLabel(widgetName: "glabel_fwd_err_pkt", text: "Forward Error Packets", enabled: true, visible: true, parentWidgetName:widgetName)
	 gcheck_fwd_err_pkt = new GCheck(widgetName: "gcheck_fwd_err_pkt", value: false, enabled: true, visible: true, parentWidgetName:widgetName)
	 glabel_fwd_undersize_pkt = new GLabel(widgetName: "glabel_fwd_undersize_pkt", text: "Forward Undersized Good Packets", enabled: true, visible: true, parentWidgetName:widgetName)
	 gcheck_fwd_undersize_pkt = new GCheck(widgetName: "gcheck_fwd_undersize_pkt", value: false, enabled: true, visible: true, parentWidgetName:widgetName)
	 glabel_rx_dma_channel_map = new GLabel(widgetName: "glabel_rx_dma_channel_map", text: "DMA Channel Map", enabled: true, visible: true, parentWidgetName:widgetName)
	 gcombo_rx_dma_channel_map = new GCombo(widgetName: "gcombo_rx_dma_channel_map", options: ["DMA Channel 0","DMA Channel 1","DMA Channel 2","DMA Channel 3"], value: "DMA Channel 0", enabled: true, visible: true, isMandatoryValue: false, parentWidgetName:widgetName)
	}
}