																			: (gfloat_fSPB_tc4.value * (float)ginteger_extclk_step_tc4.value / (1024 * 2)))
						case "fSPB":
							return gfloat_fSPB_tc4.value
						case "fCPB":
							return gfloat_fCPB_tc4.value
						case "fTPB":
							return gfloat_fTPB_tc4.value
						case "fSRI":
							return gfloat_fSRI_tc4.value
						case "fFSI":
							return gfloat_fFSI_tc4.value
						case "fSTM":
							return gfloat_fSTM_tc4.value
						case "fGTM":
							return gfloat_fGTM_tc4.value
						case "feGTM":
							return gfloat_feGTM_tc4.value
						case "fGETH":
							return gfloat_fGETH_tc4.value
						case "fMCANH":
							return gfloat_fMCANH_tc4.value
						case "fRCB":
							return gfloat_fRCB_tc4.value
						case "fLETH":
							return gfloat_fLETH_tc4.value
						case "fPPU":
							return gfloat_fPPU_tc4.value
						case "fCANXLH":
							return gfloat_fCANXLH_tc4.value
						}
						return (float)0
					}, Float))
			mf_map.put("is_extclk1_enabled_tc4", MF({gcheck_extclk_en1.value}, Boolean))
			mf_map.put("is_extclk1_fDIV1_tc4", MF({gcombo_extclk_sel1_tc4.value == "fDIV1"}, Boolean))
			mf_map.put("isnot_extclk1_fDIV1_tc4", MF({gcombo_extclk_sel1_tc4.value != "fDIV1"}, Boolean))
			mf_map.put("mf_tc4_96", MF({gcheck_extclk_en1.value && (gcombo_extclk_sel1_tc4.value == "fRAMP")}, Boolean))
			mf_map.put("mf_tc4_97",
					MF({
						switch(gcombo_extclk_sel1_tc4.value) {
						case "fBACK":
							return gfloat_fBACK_tc4.value
						case "fOSC":
							return gfloat_fOSC_tc4.value
						case "fPLL0":
							return gfloat_fPLL0_tc4.value
						case "fPLL1":
							return gfloat_fPLL1_tc4.value
						case "fPLL2":
							return gfloat_fPLL2_tc4.value
						case "fPLL3":
							return gfloat_fPLL3_tc4.value
						case "fDIV1":
							return (gfloat_fSPB_tc4.value / ((float)ginteger_extclk_div1_tc4.value + 1))
						case "fERAY":
							return gfloat_fERAY_tc4.value
						case "fMCAN":
							return gfloat_fMCAN_tc4.value
						case "fADC":
							return gfloat_fADC_tc4.value
						case "fQSPI":
							return gfloat_fQSPI_tc4.value
						case "fMSC":
							return gfloat_fMSC_tc4.value
						case "fI2C":
							return gfloat_fI2C_tc4.value
						case "fASCLINF":
							return gfloat_fASCLINF_tc4.value
						case "fASCLINS":
							return gfloat_fASCLINS_tc4.value
						case "fXSPI":
							return gfloat_fxSPI_tc4.value
						case "fSDMMC":
							return gfloat_fSDMMC_tc4.value
						case "fPPU":
							return gfloat_fPPU_tc4.value
						case "fCANXL":
							return gfloat_fCANXL_tc4.value
						case "fLETH100":
							return gfloat_fLETH100_tc4.value
						case "fXSPISL":
							return gfloat_fxSPISL_tc4.value
						}
						// fMT0
						return (float)0
					}, Float))
			mf_map.put("mf_tc4_98",
					MF({
						String result = ""
						if (gtab_clock_distributions_tc4.visible)
						{
							if ((gfloat_fOSC_tc4.value % 1) != 0) {
								result = "Error: The frequency of fOSC must be an integer value.\n"
							}
							if ((gfloat_SYSCLK_tc4.value % 1) != 0) {
								result += "Error: The frequency of SYSCLK must be an integer value.\n"
							}

							// UM - Divider ratio restrictions
							if ((gfloat_fSRI_tc4.value < gfloat_fSPB_tc4.value) || ((gfloat_fSRI_tc4.value % gfloat_fSPB_tc4.value) != 0)) {
								result += "Error: The frequency of fSRI must be an integer multiple of fSPB.\n"
							}
							if (gfloat_fCPB_tc4.visible) {
								if ((gfloat_fSRI_tc4.value < gfloat_fCPB_tc4.value) || ((gfloat_fSRI_tc4.value % gfloat_fCPB_tc4.value) != 0)) {
									result += "Error: The frequency of fSRI must be an integer multiple of fCPB.\n"
								}
							}
							if (gfloat_fTPB_tc4.visible) {
								if ((gfloat_fSRI_tc4.value < gfloat_fTPB_tc4.value) ||
									((gfloat_fSRI_tc4.value % gfloat_fTPB_tc4.value) != 0) ||
									((gfloat_fSRI_tc4.value / gfloat_fTPB_tc4.value) > 2)) {
									result += "Error: The frequency of fSRI must be an integer multiple (1,2) of fTPB.\n"
								}
								if (gfloat_fGTM_tc4.visible)
								{
									if ((gfloat_fTPB_tc4.value < gfloat_fGTM_tc4.value) || ((gfloat_fTPB_tc4.value % gfloat_fGTM_tc4.value) != 0)) {
										result += "Error: The frequencies of fTPB must be an integer multiple of fGTM.\n"
									}
								}
								if (gfloat_feGTM_tc4.visible)
								{
									if ((gfloat_fTPB_tc4.value < gfloat_feGTM_tc4.value) || ((gfloat_fTPB_tc4.value % gfloat_feGTM_tc4.value) != 0)) {
										result += "Error: The frequencies of fTPB must be an integer multiple of feGTM.\n"
									}
								}
								if ((gfloat_fTPB_tc4.value != (gfloat_fSPB_tc4.value * 2))){
									result += "Error: The frequency of fTPB must be 2 multiple of fSPB.\n"
								}
							}
							if (gfloat_fGTM_tc4.visible) {
								if ((gfloat_fGTM_tc4.value < gfloat_fSPB_tc4.value) || ((gfloat_fGTM_tc4.value % gfloat_fSPB_tc4.value) != 0)) {
									result += "Error: The frequencies of fGTM must be an integer multiple of fSPB.\n"
								}
							}
							if (gfloat_fSTM_tc4.visible) {
								if ((gfloat_fSRI_tc4.value < gfloat_fSTM_tc4.value) && ((gfloat_fSRI_tc4.value % gfloat_fSTM_tc4.value) != 0)) {
									result += "Error: The frequencies of fSRI must be an integer multiple of fSTM.\n"
								}
								if ((gfloat_fSRICS_tc4.value < gfloat_fSTM_tc4.value) && ((gfloat_fSRICS_tc4.value % gfloat_fSTM_tc4.value) != 0)) {
									result += "Error: The frequencies of fSRICS must be an integer multiple of fSTM.\n"
								}
							}
							if ((gfloat_fSRI_tc4.value < gfloat_fFSI_tc4.value) ||
								((gfloat_fSRI_tc4.value % gfloat_fFSI_tc4.value) != 0) ||
								((gfloat_fSRI_tc4.value / gfloat_fFSI_tc4.value) > 5)) {
								result += "Error: The frequency of fSRI must be an integer multiple (1,2,3,4,5) of fFSI.\n"
							}
							if ((gfloat_fFSI2_tc4.value < gfloat_fFSI_tc4.value) ||
								((gfloat_fFSI2_tc4.value % gfloat_fFSI_tc4.value) != 0) ||
								((gfloat_fFSI2_tc4.value / gfloat_fFSI_tc4.value) > 5)) {
								result += "Error: The frequency of fFSI2 must be an integer multiple (1,2,3,4,5) of fFSI.\n"
							}
							if ((gfloat_fFSI_tc4.value < (gfloat_fSPB_tc4.value / 2)) || ((gfloat_fFSI_tc4.value % (gfloat_fSPB_tc4.value / 2)) != 0)) {
								result += "Error: The frequency of fFSI must be an integer multiple of fSPB/2.\n"
							}
							if (gfloat_fMCANH_tc4.visible && gfloat_fMCAN_tc4.visible)
							{
								if (gfloat_fMCANH_tc4.value < gfloat_fMCAN_tc4.value) {
									result += "Error: The frequency of fMCANH must be faster than or equal to fMCAN.\n"
								}
							}
							if (gfloat_fCANXLH_tc4.visible && gfloat_fCANXL_tc4.visible)
							{
								if (gfloat_fCANXLH_tc4.value < gfloat_fCANXL_tc4.value) {
									result += "Error: The frequency of fCANXLH must be faster than or equal to fCANXL.\n"
								}
							}
							if (gfloat_fRCB_tc4.visible)
							{
								if (gfloat_fSRI_tc4.value != gfloat_fRCB_tc4.value * 2) {
									result += "Error: The frequencies of fSRI must be 2 multiple of fRCB.\n"
								}
							}

							if (gcombo_extclk_sel0_tc4.value == "fSTM" && !gfloat_fSTM_tc4.visible) {
								result += "Warning: fSTM cannot be used as EXTCLK0 in the current configuration.\n"
							}
							if (gcombo_extclk_sel0_tc4.value == "fRCB" && !gfloat_fRCB_tc4.visible) {
								result += "Warning: fRCB cannot be used as EXTCLK0 in the current configuration.\n"
							}
							if (gcombo_extclk_sel0_tc4.value == "fGTM" && !gfloat_fGTM_tc4.visible) {
								result += "Warning: fGTM cannot be used as EXTCLK0 in the current configuration.\n"
							}
							if (gcombo_extclk_sel0_tc4.value == "feGTM" && !gfloat_feGTM_tc4.visible) {
								result += "Warning: feGTM cannot be used as EXTCLK0 in the current configuration.\n"
							}
							if (gcombo_extclk_sel0_tc4.value == "fGETH" && !gfloat_fGETH_tc4.visible) {
								result += "Warning: fGETH cannot be used as EXTCLK0 in the current configuration.\n"
							}
							if (gcombo_extclk_sel0_tc4.value == "fLETH" && !gfloat_fLETH_tc4.visible) {
								result += "Warning: fLETH cannot be used as EXTCLK0 in the current configuration.\n"
							}
							if (gcombo_extclk_sel0_tc4.value == "fMCANH" && !gfloat_fMCANH_tc4.visible) {
								result += "Warning: fMCANH cannot be used as EXTCLK0 in the current configuration.\n"
							}
							if (gcombo_extclk_sel0_tc4.value == "fCANXLH" && !gfloat_fCANXLH_tc4.visible) {
								result += "Warning: fCANXLH cannot be used as EXTCLK0 in the current configuration.\n"
							}
							if (gcombo_extclk_sel0_tc4.value == "fTPB" && !gfloat_fTPB_tc4.visible) {
								result += "Warning: fTPB cannot be used as EXTCLK0 in the current configuration.\n"
							}
							if (gcombo_extclk_sel0_tc4.value == "fPPU" && !gfloat_fPPU_tc4.visible) {
								result += "Warning: fPPU cannot be used as EXTCLK0 in the current configuration.\n"
							}

							if (gcombo_extclk_sel1_tc4.value == "fMT0") {
								result += "Warning: fMT0 is selected as EXTCLK1 source. Make sure that the fMT0 is activated.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fERAY" && !gfloat_fERAY_tc4.visible) {
								result += "Warning: fERAY cannot be used as EXTCLK1 in the current configuration.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fADC" && !gfloat_fADC_tc4.visible) {
								result += "Warning: fADC cannot be used as EXTCLK1 in the current configuration.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fMCAN" && !gfloat_fMCAN_tc4.visible) {
								result += "Warning: fMCAN cannot be used as EXTCLK1 in the current configuration.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fCANXL" && !gfloat_fCANXL_tc4.visible) {
								result += "Warning: fCANXL cannot be used as EXTCLK1 in the current configuration.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fASCLINS" && !gfloat_fASCLINS_tc4.visible) {
								result += "Warning: fASCLINS cannot be used as EXTCLK1 in the current configuration.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fMSC" && !gfloat_fMSC_tc4.visible) {
								result += "Warning: fMSC cannot be used as EXTCLK1 in the current configuration.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fQSPI" && !gfloat_fQSPI_tc4.visible) {
								result += "Warning: fQSPI cannot be used as EXTCLK1 in the current configuration.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fASCLINF" && !gfloat_fASCLINF_tc4.visible) {
								result += "Warning: fASCLINF cannot be used as EXTCLK1 in the current configuration.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fI2C" && !gfloat_fI2C_tc4.visible) {
								result += "Warning: fI2C cannot be used as EXTCLK1 in the current configuration.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fLETH100" && !gfloat_fLETH100_tc4.visible) {
								result += "Warning: fLETH100 cannot be used as EXTCLK1 in the current configuration.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fSDMMC" && !gfloat_fSDMMC_tc4.visible) {
								result += "Warning: fSDMMC cannot be used as EXTCLK1 in the current configuration.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fXSPI" && !gfloat_fxSPI_tc4.visible) {
								result += "Warning: fXSPI cannot be used as EXTCLK1 in the current configuration.\n"
							}
							if (gcombo_extclk_sel1_tc4.value == "fXSPISL" && !gfloat_fxSPISL_tc4.visible) {
								result += "Warning: fXSPISL cannot be used as EXTCLK1 in the current configuration.\n"
							}
						}
						return result
					}, String))
			mf_map.put("mf_tc4_99", MF({gmessage_message_tc4.text.toString().contains("Error:")}, Boolean))
			mf_map.put("mf_tc4_93", MF({(gmessage_message_tc4.text != "")}, Boolean))

			CLOCK_tc4(str_series, str_variant, max_freq, mf_map)

			//==================================================================================================
			// Resource Requirement
			//==================================================================================================
			// tc4
			hwres_clockctrl_osc		= MVirtualResourceGroup("Oscillator Circuit", ["peripheral", "clock", "0", "osc"])
			hwres_clockctrl_syspll	= MVirtualResourceGroup("System PLL", ["peripheral", "clock", "0", "syspll"])
			hwres_clockctrl_peripll = MVirtualResourceGroup("Peripheral PLL", ["peripheral", "clock", "0", "perpll"])
			hwres_clockctrl_ccu		= MVirtualResourceGroup("Clock Control Unit", ["peripheral", "clock", "0", "ccu"])
			hwres_clockctrl_clkmon	= MVirtualResourceGroup("Clock Monitor", ["peripheral", "clock", "0", "clkmon"])
			hwres_clockctrl_extclk	= MVirtualResourceGroup("External Clock", ["peripheral", "clock", "0", "extclk"])
		}

		//==================================================================================================
		// Signal Requirement
		//==================================================================================================
		vs_syspll_sysclk = MVirtualSignal(hwres_clockctrl_syspll, "SYSCLK", "sysclk", MF({gcombo_pllinsel.value == "SYSCLK"}, Boolean), true)
		vs_extclk_extclk0 = MVirtualSignal(hwres_clockctrl_extclk, "EXTCLK0", "extclk0", MF({gcheck_extclk_en0.value}, Boolean), true)
		vs_extclk_extclk1 = MVirtualSignal(hwres_clockctrl_extclk, "EXTCLK1", "extclk1", MF({gcheck_extclk_en1.value}, Boolean), true)
	}
	/* End   : APP Constructor */

	/* Begin : File Generation */
	def generateFiles()
	{
		copy("clock.c", "clock.c")
		copy("clock.h", "clock.h")
		generate("clock_confc.tmpl", "clock_conf.c")
		generate("clock_confh.tmpl", "clock_conf.h")
	}
	/* End   : File Generation */
}
