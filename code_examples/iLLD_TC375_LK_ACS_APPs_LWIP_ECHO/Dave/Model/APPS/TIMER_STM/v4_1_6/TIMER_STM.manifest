package Model.APPS.TIMER_STM.v4_1_6;
// Import statements
import ifx.davex.app.manifest.*

/*************** Revision History **********************************************
 Version      Date          Description
 4.0.2        12-Sep-2025   - Initial version
 4.0.4        15-Sep-2025   - License and Copyright update
 4.1.2        23-Jan-2026   - Added support for TC4x
 4.1.4        22-May-2026   - Restrict TC4 support to TC4Dx and TC48x series
 4.1.6        29-Jul-2026   - Support to all TC4 devices
 *******************************************************************************/

class  TIMER_STM extends TIMER_STM_GUI
{
	/* Note  : Following APP properties are mandatory and important */

	/* Begin : APP property section */

	/**
	 * APP version
	 * Format: a string with three digit separated by a dot.
	 */

	def version            = '4.1.6'


	/**
	 * APP categories declaration. 
	 * It is list of strings. Subcategories are separated by slash.
	 * No limits on number of categories and subcategories depth.
	 */
	def categoriesDescription = ["Timer"] 

	/** 
	 * Minimum DAVE version required for this APP.
	 * 
	 * It is string with three digit separated by a dot.
	 */
	def minDaveVersion           = '4.2.4'

	/** 
	 * Keywords used by search feature in APPs selection view
	 * 
	 * It is a list of string.
	 */
	def keywords      = ['STM', 'Timer', 'System Timer']

	/** 
	 * softwareIDs is used to declare which devices are compatible with this APP.
	 * It is a map with key a string containing a pattern that shall match the SW id of
	 * the device and as value the minimal version of the APP.
	 */
	def softwareIDs       = [
		"TC3.*.*.*":"1.0.0",
		"TC4.*.*.*":"1.0.0"]

	/**
	 * Singleton property:
	 * When it is true the APP can be instantiated only once. 
	 */
	def singleton     = false

	/**
	 * initProvider property
	 * It shall be true to add a call to <AppName>_Init() 
	 */
	def initProvider  = true

	/**
	 * Deprecated APP
	 * Set it to true to indicate that the APP shall be not used for new projects.
	 */
	def deprecated    = false

	/**
	 * Sharable property.
	 * It shall be true to allows multiple APPs to require the same instance of this APP.
	 */
	def sharable      = false

	/**
	 *  APP function description.
	 */
	def description = "Provides an accurate timer by using hardware STM timer. This can be used as a trigger input to other peripherals or to create an event"

	/* End   : APP property section */

	/* Begin : User APP property section */

	MRequiredApp appres_clock							// Variable for acquiring the clock
	MVirtualResourceGroup hwres_stm_channel				// Declare the hardware resource group 
	MVirtualSignal vs_sr0								// STM INT0 signal
	MVirtualSignal vs_sr1								// STM INT1 signal
	GFloat gfloat_fSTM = GFloat()						// Frequency of source signal from CLOCK APP

	/* End   : User APP property section */

	/* Begin : APP Constructor */
	public TIMER_STM(DaveEnv daveEnv) 
	{
		String str_family = daveEnv.project.selectedDevice.deviceId.family

		appres_clock =  MRequiredApp("CLOCK", "CLOCK APP", RSHARABLE, "4.1.2")				// Acquire the clock from the CLOCK APP
		gfloat_fSTM.value = MF({appres_clock.getVal(["gfloat_fSTM", "value"]) * 1000 * 1000}, Float)
		
		/* -------------------------------------------------------------- */
		/* ------------ Hardware resource consumption block ------------- */
		/* -------------------------------------------------------------- */
		/* Resource group for the STM peripheral */
		if(str_family == "TC3")
		{
			hwres_stm_channel = MVirtualResourceGroup("Channel", ["peripheral", "stm", "*", "common"], true)
		}
		else
		{
			hwres_stm_channel = MVirtualResourceGroup("Channel", ["peripheral", "cpu", "*", "stm"], true)
		}

		/* -------------------------------------------------------------- */
		/* -------------- APP IO Signals -------------------------------- */
		/* -------------------------------------------------------------- */
		vs_sr0 = MVirtualSignal(hwres_stm_channel, "SR0_INT", "sr0_int", true, true)
		vs_sr1 = MVirtualSignal(hwres_stm_channel, "SR1_INT", "sr1_int", true, true)

		rArraygindexgroup_cmpch[0].gstring_info.value = MF(
		{
			long timer_period_us = (long)rArraygindexgroup_cmpch[0].ginteger_timer_period.value
			double resolution_us = (double)1000000 / (double)gfloat_fSTM.value
			double max_interval_us = (double)2.power(32) * resolution_us
			int offset
			for (offset = 0; offset <= 31; offset++)
			{
				if ((double)timer_period_us <= max_interval_us)
				{
					break
				}
				max_interval_us *= 2
				resolution_us *= 2
			}
			long compare = (long)((double)timer_period_us / resolution_us)
			double actual_interval_sec = (double)compare / (1000 * 1000) * resolution_us
			String.format(Locale.US, "%.4f / %f", resolution_us, actual_interval_sec)
		}, String)
		rArraygindexgroup_cmpch[1].gstring_info.value = MF(
		{
			long timer_period_us = (long)rArraygindexgroup_cmpch[1].ginteger_timer_period.value
			double resolution_us = (double)1000000 / (double)gfloat_fSTM.value
			double max_interval_us = (double)2.power(32) * resolution_us
			int offset
			for (offset = 0; offset <= 31; offset++)
			{
				if ((double)timer_period_us <= max_interval_us)
				{
					break
				}
				max_interval_us *= 2
				resolution_us *= 2
			}
			long compare = (long)((double)timer_period_us / resolution_us)
			double actual_interval_sec = (double)compare / (1000 * 1000) * resolution_us
			String.format(Locale.US, "%.4f / %f", resolution_us, actual_interval_sec)
		}, String)
	}
	/* End   : APP Constructor */

	/* Begin : File Generation */
	def generateFiles()
	{
		copy("timer_stm.c", "timer_stm.c")
		copy("timer_stm.h", "timer_stm.h")
		generate("timer_stm_confc.tmpl", "timer_stm_conf.c")
		generate("timer_stm_confh.tmpl", "timer_stm_conf.h")
	}
	/* End   : File Generation */
}
