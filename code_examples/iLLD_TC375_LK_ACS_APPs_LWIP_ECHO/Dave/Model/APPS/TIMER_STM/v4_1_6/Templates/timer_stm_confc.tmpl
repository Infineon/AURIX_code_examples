	for (TIMER_STM appInst : appInstancesList)
	{
		List timer_stm_uri = null						/* Used for holding TIMER channel resource assigned by solver. */
		String stm_module  = ""
		String appLabel = appInst.getInstanceLabel()	/* Get the name provided for APP instance. */

		/* Get the resources consumed by the APP and assign them to the list variables */
		timer_stm_uri = appInst.hwres_stm_channel.getSolverUri()

		/* If the channel resource is available */
		if (timer_stm_uri != null)
		{
			/* Local strings to hold resource values derived from the URI */
			String module_inst = timer_stm_uri[4]		/* TIMER_STM module instance */
			/* Set Advanced Settings value */
			if(appInst.daveEnv.project.selectedDevice.deviceId.family == "TC3")
				stm_module = "&MODULE_STM" + module_inst
			else
			{
				if (module_inst == "6")
					stm_module = "&MODULE_CPU" + "CS"
				else
					stm_module = "&MODULE_CPU" + module_inst
			}
			
			out.print("""
