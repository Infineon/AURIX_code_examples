  <provided xsi:type="ResourceModel:RegisterParameter" name="TOM0_CH10_CTRL" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl" value="00000800" toolTipHelpDescription="TOM0 Channel 10 Control Register" defaultValue="00000800" addressOffset="0x00008280" resetValue="00000800" resetMask="0x00000000">
    <bitFields name="SR0_TRIG" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/sr0_trig" value="00000000" toolTipHelpDescription="SR0 is used to generate a trigger on output TOM[0]_CH[10]_OUT_T if equal to CN0" defaultValue="00000000" startPos="7" stopPos="7" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="SR0 is used as a shadow register for register CM0."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="SR0 is not used as a shadow register for register CM0. SR0 is compared with CN0 and if both are equal, a trigger pulse is generated at output TOM[0]_CH[10]_OUT_T."/>
    </bitFields>
    <bitFields name="SL" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/sl" value="00000000" toolTipHelpDescription="Signal level for duty cycle" defaultValue="00000000" startPos="11" stopPos="11" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Low signal level"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="High signal level"/>
    </bitFields>
    <bitFields name="CLK_SRC_SR" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/clk_src_sr" value="00000000" toolTipHelpDescription="Clock source select for channel" defaultValue="00000000" startPos="12" stopPos="14" accessPermission="rw" maxValue="7" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="CMU_FXCLK (0) selected / CMU_FXCLK (0) selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="CMU_FXCLK (1) selected / CMU_FXCLK (1) selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b10" description="CMU_FXCLK (2) selected / CMU_FXCLK (2) selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b11" description="CMU_FXCLK (3) selected / CMU_FXCLK (3) selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b100" description="CMU_FXCLK (4) selected / CMU_FXCLK (4) selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b101" description="Clock of channel stopped / TRIG[x-1] selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b110" description="Clock of channel stopped / TIM_EXT_CAPTURE[10] selected"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b111" description="Clock of channel stopped / reserved"/>
    </bitFields>
    <bitFields name="ECLK_SRC" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/eclk_src" value="00000000" toolTipHelpDescription="Extend CLK_SRC" defaultValue="00000000" startPos="15" stopPos="15" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="CLK_SRC_SR set 1 selected (see bit CLK_SRC_SR)"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="CLK_SRC_SR set 2 selected (see bit CLK_SRC_SR)"/>
    </bitFields>
    <bitFields name="TRIG_PULSE" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/trig_pulse" value="00000000" toolTipHelpDescription="Trigger output pulse length of one SYS_CLK period" defaultValue="00000000" startPos="17" stopPos="17" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Output on TOM[0]_OUT[10]_T is 1 as long as CN0=SR0 (if SR=_TRIG=1)"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Output on TOM[0]_OUT[10]_T is 1 for only one SYS_CLK period if CN0=SR0 (if SR=_TRIG=1)"/>
    </bitFields>
    <bitFields name="UDMODE" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/udmode" value="00000000" toolTipHelpDescription="Up-down counter mode" defaultValue="00000000" startPos="18" stopPos="19" accessPermission="rw" maxValue="3" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Up-down counter mode disabled: CN0 counts always up"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Up-down counter mode enabled: CN0 counts up and down, CM0, CM1 are updated if CN0 reaches 0 (i.e. changes from down to up)"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b10" description="Up-down counter mode enabled: CN0 counts up and down, CM0, CM1 are updated if CN0 reaches CM0 (i.e. changes from up to down)"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b11" description="Up-down counter mode enabled: CN0 counts up and down, CM0, CM1 are updated if CN0 reaches 0 or CM0 (i.e. changes direction)"/>
    </bitFields>
    <bitFields name="RST_CCU0" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/rst_ccu0" value="00000000" toolTipHelpDescription="Reset source of CCU0" defaultValue="00000000" startPos="20" stopPos="20" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Reset counter register CN0 to 0 on matching comparison CM0"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Reset counter register CN0 to 0 on trigger TRIG_[x-1] or TIM_EXT_CAPTURE(10)."/>
    </bitFields>
    <bitFields name="OSM_TRIG" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/osm_trig" value="00000000" toolTipHelpDescription="Enable trigger of one-shot pulse by trigger signal OSM_TRIG" defaultValue="00000000" startPos="21" stopPos="21" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Signal OSM_TRIG cannot trigger start of single pulse generation"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Signal OSM_TRIG can trigger start of single pulse generation (only if bit OSM = 1)"/>
    </bitFields>
    <bitFields name="EXT_TRIG" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/ext_trig" value="00000000" toolTipHelpDescription="Select TIM_EXT_CAPTURE(10) as trigger signal" defaultValue="00000000" startPos="22" stopPos="22" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Signal TRIG_[x-1] is selected as trigger to reset CN0 or to start single pulse generation"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Signal TIM_EXT_CAPTURE(10) is selected"/>
    </bitFields>
    <bitFields name="EXTTRIGOUT" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/exttrigout" value="00000000" toolTipHelpDescription="TIM_EXT_CAPTURE(10) as potential output signal TRIG_[10]" defaultValue="00000000" startPos="23" stopPos="23" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Signal TRIG_[x-1] is selected as output on TRIG_[10] (if TRIGOUT=0)"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Signal TIM_EXT_CAPTURE(10) is selected as output on TRIG_[10] (if TRIGOUT=0)"/>
    </bitFields>
    <bitFields name="TRIGOUT" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/trigout" value="00000000" toolTipHelpDescription="Trigger output selection (output signal TRIG_[10]) of module TOM_CH[10]" defaultValue="00000000" startPos="24" stopPos="24" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="TRIG_[10] is TRIG_[x-1] or TIM _EXT_CAPTURE(10)"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="TRIG_[10] is TRIG_CCU0"/>
    </bitFields>
    <bitFields name="SPE_TRIG" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/spe_trig" value="00000000" toolTipHelpDescription="SPE trigger to reset CN0" defaultValue="00000000" startPos="25" stopPos="25" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="TOM[0]_CH[10]_OUT defined by TOM[0] channel 10 SOUR register, CN0 reset is defined by configuration of bit RST_CCU0 / TOM[0]_CH[10]_OUT is defined by SPE[0]_OUT[10], CN0 is reset by signal SPE[0]_NIPD"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="TOM[0]_CH[10]_OUT defined by TOM[0] channel 10 SOUR register, CN0 is reset by signal SPE[0]_NIPD / TOM[0]_CH[10]_OUT is defined by SPE[0]_OUT[10], CN0 reset is defined by configuration of bit RST_CCU0"/>
    </bitFields>
    <bitFields name="OSM" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/osm" value="00000000" toolTipHelpDescription="One-shot mode" defaultValue="00000000" startPos="26" stopPos="26" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="One-shot mode disabled"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="One-shot mode enabled"/>
    </bitFields>
    <bitFields name="BITREV" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/bitrev" value="00000000" toolTipHelpDescription="Bit-reversing of output of counter register CN0" defaultValue="00000000" startPos="27" stopPos="27" accessPermission="rw" maxValue="1" minValue="0"/>
    <bitFields name="SPEM" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/spem" value="00000000" toolTipHelpDescription="SPE output mode enable for channel" defaultValue="00000000" startPos="28" stopPos="28" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="SPE output mode disabled: TOM[0]_CH[10]_OUT defined by TOM[0] channel 10 SOUR register"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="SPE output mode enabled: TOM[0]_CH[10]_OUT is defined by SPE[0]_OUT[10]"/>
    </bitFields>
    <bitFields name="GCM" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/gcm" value="00000000" toolTipHelpDescription="Gated Counter Mode enable" defaultValue="00000000" startPos="29" stopPos="29" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Gated Counter mode disabled"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Gated Counter mode enabled"/>
    </bitFields>
    <bitFields name="FREEZE" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/freeze" value="00000000" toolTipHelpDescription="FREEZE" defaultValue="00000000" startPos="31" stopPos="31" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="A channel disable/enable may change internal register and output register"/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="A channel enable/disable does not change an internal or output register, but stops counter CN0"/>
    </bitFields>
  </provided>
