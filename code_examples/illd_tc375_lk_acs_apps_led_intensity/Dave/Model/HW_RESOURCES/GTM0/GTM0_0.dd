    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Up-down counter mode disabled: CN0 counts always up"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Up-down counter mode enabled: CN0 counts up and down, CM0, CM1 are updated if CN0 reaches 0 (i.e. changes from down to up)"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b10" description="Up-down counter mode enabled: CN0 counts up and down, CM0, CM1 are updated if CN0 reaches CM0 (i.e. changes from up to down)"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b11" description="Up-down counter mode enabled: CN0 counts up and down, CM0, CM1 are updated if CN0 reaches 0 or CM0 (i.e. changes direction)"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="RST_CCU0" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/rst_ccu0" value="00000000" toolTipHelpDescription="Reset source of CCU0" defaultValue="00000000" startPos="20" stopPos="20" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Reset counter register CN0 to 0 on matching comparison CM0"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Reset counter register CN0 to 0 on trigger TRIG_[x-1] or TIM_EXT_CAPTURE(10)."/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="OSM_TRIG" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/osm_trig" value="00000000" toolTipHelpDescription="Enable trigger of one-shot pulse by trigger signal OSM_TRIG" defaultValue="00000000" startPos="21" stopPos="21" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Signal OSM_TRIG cannot trigger start of single pulse generation"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Signal OSM_TRIG can trigger start of single pulse generation (only if bit OSM = 1)"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="EXTTRIGOUT" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/exttrigout" value="00000000" toolTipHelpDescription="TIM_EXT_CAPTURE(10) as potential output signal TRIG_[10]" defaultValue="00000000" startPos="23" stopPos="23" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Signal TRIG_[x-1] is selected as output on TRIG_[10] (if TRIGOUT=0)"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Signal TIM_EXT_CAPTURE(10) is selected as output on TRIG_[10] (if TRIGOUT=0)"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="TRIGOUT" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/trigout" value="00000000" toolTipHelpDescription="Trigger output selection (output signal TRIG_[10]) of module TOM_CH[10]" defaultValue="00000000" startPos="24" stopPos="24" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="TRIG_[10] is TRIG_[x-1] or TIM _EXT_CAPTURE(10)"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="TRIG_[10] is TRIG_CCU0"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="SPE_TRIG" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/spe_trig" value="00000000" toolTipHelpDescription="SPE trigger to reset CN0" defaultValue="00000000" startPos="25" stopPos="25" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="TOM[0]_CH[10]_OUT defined by TOM[0] channel 10 SOUR register, CN0 reset is defined by configuration of bit RST_CCU0 / TOM[0]_CH[10]_OUT is defined by SPE[0]_OUT[10], CN0 is reset by signal SPE[0]_NIPD"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="TOM[0]_CH[10]_OUT defined by TOM[0] channel 10 SOUR register, CN0 is reset by signal SPE[0]_NIPD / TOM[0]_CH[10]_OUT is defined by SPE[0]_OUT[10], CN0 reset is defined by configuration of bit RST_CCU0"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="OSM" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/osm" value="00000000" toolTipHelpDescription="One-shot mode" defaultValue="00000000" startPos="26" stopPos="26" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="One-shot mode disabled"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="One-shot mode enabled"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="BITREV" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/bitrev" value="00000000" toolTipHelpDescription="Bit-reversing of output of counter register CN0" defaultValue="00000000" startPos="27" stopPos="27" accessPermission="rw" maxValue="1" minValue="0"/>
  <provided xsi:type="ResourceModel:BitField" name="SPEM" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/spem" value="00000000" toolTipHelpDescription="SPE output mode enable for channel" defaultValue="00000000" startPos="28" stopPos="28" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="SPE output mode disabled: TOM[0]_CH[10]_OUT defined by TOM[0] channel 10 SOUR register"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="SPE output mode enabled: TOM[0]_CH[10]_OUT is defined by SPE[0]_OUT[10]"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="GCM" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/gcm" value="00000000" toolTipHelpDescription="Gated Counter Mode enable" defaultValue="00000000" startPos="29" stopPos="29" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Gated Counter mode disabled"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Gated Counter mode enabled"/>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="FREEZE" URI="http://resources/4.3.3/peripheral/gtm/0/tom0_ch10_ctrl/freeze" value="00000000" toolTipHelpDescription="FREEZE" defaultValue="00000000" startPos="31" stopPos="31" accessPermission="rw" maxValue="1" minValue="0">
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="A channel disable/enable may change internal register and output register"/>
    <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="A channel enable/disable does not change an internal or output register, but stops counter CN0"/>
  </provided>
