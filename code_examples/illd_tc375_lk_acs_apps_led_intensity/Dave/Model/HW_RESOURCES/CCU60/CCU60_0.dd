  <provided xsi:type="ResourceModel:RegisterParameter" name="CCU60_PISEL2" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_pisel2" value="00000000" toolTipHelpDescription="Port Input Select Register 2" defaultValue="00000000" addressOffset="0x00000014" resetValue="00000000" resetMask="0x00000000">
    <bitFields name="IST13HR" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_pisel2/ist13hr" value="00000000" toolTipHelpDescription="Input Select for T13HR" defaultValue="00000000" startPos="0" stopPos="1" accessPermission="rw" maxValue="3" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Either signal T13HRA (if T13EXT = 0) or T13HRE (if T13EXT = 1) is selected."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Either signal T13HRB (if T13EXT = 0) or T13HRF (if T13EXT = 1) is selected."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b10" description="Either signal T13HRC (if T13EXT = 0) or T13HRG (if T13EXT = 1) is selected."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b11" description="Either signal T13HRD (if T13EXT = 0) or T13HRH (if T13EXT = 1) is selected."/>
    </bitFields>
    <bitFields name="ISCNT12" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_pisel2/iscnt12" value="00000000" toolTipHelpDescription="Input Select for T12 Counting Input" defaultValue="00000000" startPos="2" stopPos="3" accessPermission="rw" maxValue="3" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="The T12 prescaler generates the counting events. Bit TCTR4.T12CNT is not taken into account."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Bit TCTR4.T12CNT written with 1 is a counting event. The T12 prescaler is not taken into account."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b10" description="The timer T12 is counting each rising edge detected in the selected T12HR signal."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b11" description="The timer T12 is counting each falling edge detected in the selected T12HR signal."/>
    </bitFields>
    <bitFields name="ISCNT13" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_pisel2/iscnt13" value="00000000" toolTipHelpDescription="Input Select for T13 Counting Input" defaultValue="00000000" startPos="4" stopPos="5" accessPermission="rw" maxValue="3" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="The T13 prescaler generates the counting events. Bit TCTR4.T13CNT is not taken into account."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Bit TCTR4.T13CNT written with 1 is a counting event. The T13 prescaler is not taken into account."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b10" description="The timer T13 is counting each rising edge detected in the selected T13HR signal."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b11" description="The timer T13 is counting each falling edge detected in the selected T13HR signal."/>
    </bitFields>
    <bitFields name="T12EXT" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_pisel2/t12ext" value="00000000" toolTipHelpDescription="Extension for T12HR Inputs" defaultValue="00000000" startPos="6" stopPos="6" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="One of the signals T12HR[D:A] is selected."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="One of the signals T12HR[H:E] is selected."/>
    </bitFields>
