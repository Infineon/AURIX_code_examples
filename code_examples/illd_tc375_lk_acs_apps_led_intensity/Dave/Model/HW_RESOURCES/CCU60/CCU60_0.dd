  <provided xsi:type="ResourceModel:RegisterParameter" name="CCU60_TRPCTR" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_trpctr" value="00000000" toolTipHelpDescription="Trap Control Register" defaultValue="00000000" addressOffset="0x00000084" resetValue="00000000" resetMask="0x00000000">
    <bitFields name="TRPM0" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_trpctr/trpm0" value="00000000" toolTipHelpDescription="Trap Mode Control Bit 0" defaultValue="00000000" startPos="0" stopPos="0" accessPermission="rw" maxValue="1" minValue="0"/>
    <bitFields name="TRPM1" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_trpctr/trpm1" value="00000000" toolTipHelpDescription="Trap Mode Control Bit 1" defaultValue="00000000" startPos="1" stopPos="1" accessPermission="rw" maxValue="1" minValue="0"/>
    <bitFields name="TRPM2" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_trpctr/trpm2" value="00000000" toolTipHelpDescription="Trap Mode Control Bit 2" defaultValue="00000000" startPos="2" stopPos="2" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="Automatic Mode: Bit TRPF is cleared by HW if the trap input condition is no longer valid."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="Manual Mode: Bit TRPF stays 1 after the trap input condition is no longer valid. It has to be cleared by SW by writing ISR.RTRPF = 1."/>
    </bitFields>
    <bitFields name="TRPEN" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_trpctr/trpen" value="00000000" toolTipHelpDescription="Trap Enable Control" defaultValue="00000000" startPos="8" stopPos="13" accessPermission="rw" maxValue="63" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="The trap functionality of the corresponding output signal is disabled. The output state is independent from bit IS.TRPS."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="The trap functionality of the corresponding output signal is enabled. The output state is set to the passive while IS.TRPS=1."/>
    </bitFields>
    <bitFields name="TRPEN13" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_trpctr/trpen13" value="00000000" toolTipHelpDescription="Trap Enable Control for Timer T13" defaultValue="00000000" startPos="14" stopPos="14" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="The trap functionality for output COUT63 is disabled. The output state is independent from bit IS.TRPS."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="The trap functionality for output COUT63 is enabled. The output state is set to the passive while IS.TRPS=1."/>
    </bitFields>
    <bitFields name="TRPPEN" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_trpctr/trppen" value="00000000" toolTipHelpDescription="Trap Pin Enable" defaultValue="00000000" startPos="15" stopPos="15" accessPermission="rw" maxValue="1" minValue="0">
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b0" description="The CCU6 trap functionality based on the input CTRAP is disabled. A CCU6 trap can only be generated by SW by setting bit TRPF."/>
      <enumValues xsi:type="ResourceModel:RegEnumValue" value="0b1" description="The CCU6 trap functionality based on the input CTRAP is enabled. A CCU6 trap can be generated by SW by setting bit TRPF or by CTRAP=0."/>
    </bitFields>
  </provided>
  <provided xsi:type="ResourceModel:BitField" name="TRPEN" URI="http://resources/4.0.2/peripheral/ccu6/0/ccu60_trpctr/trpen" value="00000000" toolTipHelpDescription="Trap Enable Control" defaultValue="00000000" startPos="8" stopPos="13" accessPermission="rw" maxValue="63" minValue="0">
