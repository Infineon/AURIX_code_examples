	def getCHDWValue(width)
	{
		def move_size = null

		switch(width)
		{
		case "8-bit":
			move_size = "8bit"
			break

		case "16-bit":
			move_size = "16bit"
			break

		case "32-bit":
			move_size = "32bit"
			break

		case "64-bit":
			move_size = "64bit"
			break

		case "128-bit":
			move_size = "128bit"
			break

		case "256-bit":
			move_size = "256bit"
			break

		case "512-bit":
			move_size = "512bit"
			break

		default:
			break
		}

		return move_size;
	}

	def getStepValue(step)
	{
		def step_value = null

		switch(step)
		{
		case "1 x CHDW":
			step_value = "1"
			break

		case "2 x CHDW":
			step_value = "2"
			break

		case "4 x CHDW":
			step_value = "4"
			break

		case "8 x CHDW":
			step_value = "8"
			break

		case "16 x CHDW":
			step_value = "16"
			break

		case "32 x CHDW":
			step_value = "32"
			break

		case "64 x CHDW":
			step_value = "64"
			break

		case "128 x CHDW":
			step_value = "128"
			break

		default:
			break
		}

		return step_value;
	}

	def getCircularBufferValue(length)
	{
		def length_value = null

		switch(length)
		{
		case "1":
			length_value = "none"
			break

		default:
			length_value = length
			break
		}

		return length_value;
	}

	def checkisAddressValid(address, variableAdrsRegExp, hexAdrsRegExp)
	{
		def checked_address = "ADDRESS_INVALID"

		Matcher matcher = (address =~ variableAdrsRegExp)

		boolean address_is_static = matcher.matches()

		matcher = (address =~ hexAdrsRegExp)

		boolean address_is_dynamic = matcher.matches()

		if(address_is_static || address_is_dynamic)
		{
			checked_address = address
		}

		return checked_address;
	}

	def checkAndExternAddressSymbol(expression, name, addressType)
	{
		Matcher matcher = (name =~ expression)

		boolean is_a_variable = matcher.matches()

		if(is_a_variable)
		{
			out.print("""
/* ${addressType} address symbol */
/* Considered as Linked List Node 0  ${addressType} address symbol for Linked List operation */
extern volatile uint32 ${name}[];
""")
		}
	}

	def checkAndExternLLAddressSymbol(expression, name, index, addressType)
	{
		Matcher matcher = (name =~ expression)

		boolean is_a_variable = matcher.matches()

		if(is_a_variable)
		{
			out.print("""
/* Linked List Node ${index} ${addressType} address symbol */
extern volatile uint32 ${name}[];
""")
		}
	}

