		// -------------- Hardware Resource Groups ------------------------------------------------------------------ //
		hwres_AdcGroup = MVirtualResourceGroup("ADC Group", ["peripheral", "evadc", "*", "gr", "*"])


		// -------------- Dynamic Channel Acquisition --------------------------------------------------------------- //
		sv_sigch_name_00 = SolverVariable()
		addUriElementRangeConstraint(sv_sigch_name_00,
									["ch0", "ch1", "ch2", "ch3", "ch4", "ch5", "ch6", "ch7", "ch8", "ch9", "ch10", "ch11", "ch12", "ch13", "ch14", "ch15"])
		vs_sigch_00 = MVirtualSignal(hwres_AdcGroup, "IN #0", sv_sigch_name_00, MF({0 < ginteger_NumChannels.value}, Boolean), false)
		hwres_port_00 = MVirtualResourceGroup("Input #0 pin", ["port", "*", "*", "pad", "*"], MF({0 < ginteger_NumChannels.value}, Boolean))
		@AddPin(pinDisplayName = 'IN #0 pin')
				vs_port_pad_00 = MVirtualSignal(hwres_port_00, "IN #0 pin", "pad", MF({0 < ginteger_NumChannels.value}, Boolean), false)
		addConnectionConstraint(vs_port_pad_00, vs_sigch_00)

		sv_sigch_name_01 = SolverVariable()
