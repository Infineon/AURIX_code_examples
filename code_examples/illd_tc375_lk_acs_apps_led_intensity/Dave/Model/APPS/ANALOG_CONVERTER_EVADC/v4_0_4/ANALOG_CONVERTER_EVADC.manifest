		// return !sv_sigch_name_00.getSolverValue() && sv_sigch_name_00.getSolverValue().startsWith("ch"); // Check if solver assigned something :)

		// Auto Start checkbox is enabled only if trigger is set to none (external trigger always result in conversion start after init)
		gcheck_autostart.visible = MF({	return gcombo_TriggerEdge.value == "None"; }, Boolean)
		gcheck_autostart_dis.visible = MF({	return !gcheck_autostart.visible }, Boolean)
		gstring_autoStart.value = MF({if(gcheck_autostart.value || !gcheck_autostart.visible ) return "TRUE"; else return "FALSE";}, String);

		// A Nasty hack to check how many channels are enabled
		// We can check if a channel is enabled if the solver was able to grant the number of requested channels
		// If the solver fails, the value of the ginteger_NumChannels will reset to last known working number
		MF MF_CH00_Enabled = MF({ return ginteger_NumChannels.value > 0  }, Boolean);
		MF MF_CH01_Enabled = MF({ return ginteger_NumChannels.value > 1  }, Boolean);
		MF MF_CH02_Enabled = MF({ return ginteger_NumChannels.value > 2  }, Boolean);
		MF MF_CH03_Enabled = MF({ return ginteger_NumChannels.value > 3  }, Boolean);
		MF MF_CH04_Enabled = MF({ return ginteger_NumChannels.value > 4  }, Boolean);
		MF MF_CH05_Enabled = MF({ return ginteger_NumChannels.value > 5  }, Boolean);
		MF MF_CH06_Enabled = MF({ return ginteger_NumChannels.value > 6  }, Boolean);
		MF MF_CH07_Enabled = MF({ return ginteger_NumChannels.value > 7  }, Boolean);
		MF MF_CH08_Enabled = MF({ return ginteger_NumChannels.value > 8  }, Boolean);
		MF MF_CH09_Enabled = MF({ return ginteger_NumChannels.value > 9  }, Boolean);
		MF MF_CH10_Enabled = MF({ return ginteger_NumChannels.value > 10 }, Boolean);
		MF MF_CH11_Enabled = MF({ return ginteger_NumChannels.value > 11 }, Boolean);
		MF MF_CH12_Enabled = MF({ return ginteger_NumChannels.value > 12 }, Boolean);
		MF MF_CH13_Enabled = MF({ return ginteger_NumChannels.value > 13 }, Boolean);
		MF MF_CH14_Enabled = MF({ return ginteger_NumChannels.value > 14 }, Boolean);
		MF MF_CH15_Enabled = MF({ return ginteger_NumChannels.value > 15 }, Boolean);

		MF MF_CH00_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 0  && gcombo_EventGenerationChannel00.value != "None"}, Boolean);
		MF MF_CH01_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 1  && gcombo_EventGenerationChannel01.value != "None"}, Boolean);
		MF MF_CH02_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 2  && gcombo_EventGenerationChannel02.value != "None"}, Boolean);
		MF MF_CH03_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 3  && gcombo_EventGenerationChannel03.value != "None"}, Boolean);
		MF MF_CH04_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 4  && gcombo_EventGenerationChannel04.value != "None"}, Boolean);
		MF MF_CH05_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 5  && gcombo_EventGenerationChannel05.value != "None"}, Boolean);
		MF MF_CH06_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 6  && gcombo_EventGenerationChannel06.value != "None"}, Boolean);
		MF MF_CH07_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 7  && gcombo_EventGenerationChannel07.value != "None"}, Boolean);
		MF MF_CH08_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 8  && gcombo_EventGenerationChannel08.value != "None"}, Boolean);
		MF MF_CH09_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 9  && gcombo_EventGenerationChannel09.value != "None"}, Boolean);
		MF MF_CH10_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 10 && gcombo_EventGenerationChannel10.value != "None"}, Boolean);
		MF MF_CH11_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 11 && gcombo_EventGenerationChannel11.value != "None"}, Boolean);
		MF MF_CH12_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 12 && gcombo_EventGenerationChannel12.value != "None"}, Boolean);
		MF MF_CH13_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 13 && gcombo_EventGenerationChannel13.value != "None"}, Boolean);
		MF MF_CH14_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 14 && gcombo_EventGenerationChannel14.value != "None"}, Boolean);
		MF MF_CH15_ServiceRequestEnabled = MF({return ginteger_NumChannels.value > 15 && gcombo_EventGenerationChannel15.value != "None"}, Boolean);

		MF MF_CH00_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 0  &&  gcombo_EventGenerationChannel00.value == "CPU"}, Boolean);
		MF MF_CH01_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 1  &&  gcombo_EventGenerationChannel01.value == "CPU"}, Boolean);
		MF MF_CH02_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 2  &&  gcombo_EventGenerationChannel02.value == "CPU"}, Boolean);
		MF MF_CH03_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 3  &&  gcombo_EventGenerationChannel03.value == "CPU"}, Boolean);
		MF MF_CH04_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 4  &&  gcombo_EventGenerationChannel04.value == "CPU"}, Boolean);
		MF MF_CH05_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 5  &&  gcombo_EventGenerationChannel05.value == "CPU"}, Boolean);
		MF MF_CH06_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 6  &&  gcombo_EventGenerationChannel06.value == "CPU"}, Boolean);
		MF MF_CH07_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 7  &&  gcombo_EventGenerationChannel07.value == "CPU"}, Boolean);
		MF MF_CH08_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 8  &&  gcombo_EventGenerationChannel08.value == "CPU"}, Boolean);
		MF MF_CH09_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 9  &&  gcombo_EventGenerationChannel09.value == "CPU"}, Boolean);
		MF MF_CH10_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 10 &&  gcombo_EventGenerationChannel10.value == "CPU"}, Boolean);
		MF MF_CH11_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 11 &&  gcombo_EventGenerationChannel11.value == "CPU"}, Boolean);
		MF MF_CH12_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 12 &&  gcombo_EventGenerationChannel12.value == "CPU"}, Boolean);
		MF MF_CH13_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 13 &&  gcombo_EventGenerationChannel13.value == "CPU"}, Boolean);
		MF MF_CH14_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 14 &&  gcombo_EventGenerationChannel14.value == "CPU"}, Boolean);
		MF MF_CH15_ServiceRequestToCPU = MF({return ginteger_NumChannels.value > 15 &&  gcombo_EventGenerationChannel15.value == "CPU"}, Boolean);

		// Name validation for custom channel names
		MF MF_errorinfo_string = MF(
				{
					if (!( // Negation because reverse logic for visibility of gmessage widget
							gstring_Channel00Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel01Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel02Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel03Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel04Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel05Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel06Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel07Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel08Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel09Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel10Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel11Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel12Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel13Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel14Name.value ==~ mCStyleRegexPattern &&
							gstring_Channel15Name.value ==~ mCStyleRegexPattern))
					{
						return "Please use C Style names for channels!";
					}
					List<String> names = [
						gstring_Channel00Name.value,
						gstring_Channel01Name.value,
						gstring_Channel02Name.value,
						gstring_Channel03Name.value,
						gstring_Channel04Name.value,
						gstring_Channel05Name.value,
						gstring_Channel06Name.value,
						gstring_Channel07Name.value,
						gstring_Channel08Name.value,
						gstring_Channel09Name.value,
						gstring_Channel10Name.value,
						gstring_Channel11Name.value,
						gstring_Channel12Name.value,
						gstring_Channel13Name.value,
						gstring_Channel14Name.value,
						gstring_Channel15Name.value
					];
					if (new HashSet(names).size() != names.size())
					{
						return "Please use a unique names for each channel!";
					}
					return "";
				}, String);


		// -------------- Required APPs ----------------------------------------------------------------------------- //

		// If result event per channel selected, get INTERRUPT_CONFIG APP from the solver
		appres_icfg00 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #0", RNOTSHARABLE, "4.0.2", MF_CH00_ServiceRequestToCPU);
		appres_icfg01 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #1", RNOTSHARABLE, "4.0.2", MF_CH01_ServiceRequestToCPU);
		appres_icfg02 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #2", RNOTSHARABLE, "4.0.2", MF_CH02_ServiceRequestToCPU);
		appres_icfg03 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #3", RNOTSHARABLE, "4.0.2", MF_CH03_ServiceRequestToCPU);
		appres_icfg04 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #4", RNOTSHARABLE, "4.0.2", MF_CH04_ServiceRequestToCPU);
		appres_icfg05 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #5", RNOTSHARABLE, "4.0.2", MF_CH05_ServiceRequestToCPU);
		appres_icfg06 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #6", RNOTSHARABLE, "4.0.2", MF_CH06_ServiceRequestToCPU);
		appres_icfg07 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #7", RNOTSHARABLE, "4.0.2", MF_CH07_ServiceRequestToCPU);
		appres_icfg08 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #8", RNOTSHARABLE, "4.0.2", MF_CH08_ServiceRequestToCPU);
		appres_icfg09 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #9", RNOTSHARABLE, "4.0.2", MF_CH09_ServiceRequestToCPU);
		appres_icfg10 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #10", RNOTSHARABLE, "4.0.2", MF_CH10_ServiceRequestToCPU);
		appres_icfg11 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #11", RNOTSHARABLE, "4.0.2", MF_CH11_ServiceRequestToCPU);
		appres_icfg12 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #12", RNOTSHARABLE, "4.0.2", MF_CH12_ServiceRequestToCPU);
		appres_icfg13 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #13", RNOTSHARABLE, "4.0.2", MF_CH13_ServiceRequestToCPU);
		appres_icfg14 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #14", RNOTSHARABLE, "4.0.2", MF_CH14_ServiceRequestToCPU);
		appres_icfg15 = MRequiredApp("INTERRUPT_CONFIG", "INTERRUPT_CONFIG APP #15", RNOTSHARABLE, "4.0.2", MF_CH15_ServiceRequestToCPU);

		vs_appres_icfg00 = MVirtualSignalRA(appres_icfg00, "vs_interrupt_in");
		vs_appres_icfg01 = MVirtualSignalRA(appres_icfg01, "vs_interrupt_in");
		vs_appres_icfg02 = MVirtualSignalRA(appres_icfg02, "vs_interrupt_in");
		vs_appres_icfg03 = MVirtualSignalRA(appres_icfg03, "vs_interrupt_in");
		vs_appres_icfg04 = MVirtualSignalRA(appres_icfg04, "vs_interrupt_in");
		vs_appres_icfg05 = MVirtualSignalRA(appres_icfg05, "vs_interrupt_in");
		vs_appres_icfg06 = MVirtualSignalRA(appres_icfg06, "vs_interrupt_in");
		vs_appres_icfg07 = MVirtualSignalRA(appres_icfg07, "vs_interrupt_in");
		vs_appres_icfg08 = MVirtualSignalRA(appres_icfg08, "vs_interrupt_in");
		vs_appres_icfg09 = MVirtualSignalRA(appres_icfg09, "vs_interrupt_in");
		vs_appres_icfg10 = MVirtualSignalRA(appres_icfg10, "vs_interrupt_in");
		vs_appres_icfg11 = MVirtualSignalRA(appres_icfg11, "vs_interrupt_in");
		vs_appres_icfg12 = MVirtualSignalRA(appres_icfg12, "vs_interrupt_in");
		vs_appres_icfg13 = MVirtualSignalRA(appres_icfg13, "vs_interrupt_in");
		vs_appres_icfg14 = MVirtualSignalRA(appres_icfg14, "vs_interrupt_in");
		vs_appres_icfg15 = MVirtualSignalRA(appres_icfg15, "vs_interrupt_in");

		/* -------------- Event and Interrupt Signals --------------------------------------------------------------- */
		vs_sigRev00 = MVirtualSignal(hwres_AdcGroup, "INT #0",  "rev0" , (MF_CH00_ServiceRequestEnabled), (MF_CH00_ServiceRequestEnabled));
		vs_sigRev01 = MVirtualSignal(hwres_AdcGroup, "INT #1",  "rev1" , (MF_CH01_ServiceRequestEnabled), (MF_CH01_ServiceRequestEnabled));
		vs_sigRev02 = MVirtualSignal(hwres_AdcGroup, "INT #2",  "rev2" , (MF_CH02_ServiceRequestEnabled), (MF_CH02_ServiceRequestEnabled));
		vs_sigRev03 = MVirtualSignal(hwres_AdcGroup, "INT #3",  "rev3" , (MF_CH03_ServiceRequestEnabled), (MF_CH03_ServiceRequestEnabled));
		vs_sigRev04 = MVirtualSignal(hwres_AdcGroup, "INT #4",  "rev4" , (MF_CH04_ServiceRequestEnabled), (MF_CH04_ServiceRequestEnabled));
		vs_sigRev05 = MVirtualSignal(hwres_AdcGroup, "INT #5",  "rev5" , (MF_CH05_ServiceRequestEnabled), (MF_CH05_ServiceRequestEnabled));
		vs_sigRev06 = MVirtualSignal(hwres_AdcGroup, "INT #6",  "rev6" , (MF_CH06_ServiceRequestEnabled), (MF_CH06_ServiceRequestEnabled));
		vs_sigRev07 = MVirtualSignal(hwres_AdcGroup, "INT #7",  "rev7" , (MF_CH07_ServiceRequestEnabled), (MF_CH07_ServiceRequestEnabled));
		vs_sigRev08 = MVirtualSignal(hwres_AdcGroup, "INT #8",  "rev8" , (MF_CH08_ServiceRequestEnabled), (MF_CH08_ServiceRequestEnabled));
		vs_sigRev09 = MVirtualSignal(hwres_AdcGroup, "INT #9",  "rev9" , (MF_CH09_ServiceRequestEnabled), (MF_CH09_ServiceRequestEnabled));
		vs_sigRev10 = MVirtualSignal(hwres_AdcGroup, "INT #10", "rev10", (MF_CH10_ServiceRequestEnabled), (MF_CH10_ServiceRequestEnabled));
		vs_sigRev11 = MVirtualSignal(hwres_AdcGroup, "INT #11", "rev11", (MF_CH11_ServiceRequestEnabled), (MF_CH11_ServiceRequestEnabled));
		vs_sigRev12 = MVirtualSignal(hwres_AdcGroup, "INT #12", "rev12", (MF_CH12_ServiceRequestEnabled), (MF_CH12_ServiceRequestEnabled));
		vs_sigRev13 = MVirtualSignal(hwres_AdcGroup, "INT #13", "rev13", (MF_CH13_ServiceRequestEnabled), (MF_CH13_ServiceRequestEnabled));
		vs_sigRev14 = MVirtualSignal(hwres_AdcGroup, "INT #14", "rev14", (MF_CH14_ServiceRequestEnabled), (MF_CH14_ServiceRequestEnabled));
		vs_sigRev15 = MVirtualSignal(hwres_AdcGroup, "INT #15", "rev15", (MF_CH15_ServiceRequestEnabled), (MF_CH15_ServiceRequestEnabled));

		// Connections for channel events and interrupt_config appres
		addConnectionConstraint(vs_sigRev00, vs_appres_icfg00, MF_CH00_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev01, vs_appres_icfg01, MF_CH01_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev02, vs_appres_icfg02, MF_CH02_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev03, vs_appres_icfg03, MF_CH03_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev04, vs_appres_icfg04, MF_CH04_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev05, vs_appres_icfg05, MF_CH05_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev06, vs_appres_icfg06, MF_CH06_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev07, vs_appres_icfg07, MF_CH07_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev08, vs_appres_icfg08, MF_CH08_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev09, vs_appres_icfg09, MF_CH09_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev10, vs_appres_icfg10, MF_CH10_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev11, vs_appres_icfg11, MF_CH11_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev12, vs_appres_icfg12, MF_CH12_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev13, vs_appres_icfg13, MF_CH13_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev14, vs_appres_icfg14, MF_CH14_ServiceRequestToCPU);
		addConnectionConstraint(vs_sigRev15, vs_appres_icfg15, MF_CH15_ServiceRequestToCPU);

		// Trigger flag (if none, the software should start/stop conversion)
		MF MF_is_exttrig = MF({gcombo_TriggerEdge.value != "None"}, Boolean)
		vs_exttrig = MVirtualSignal(hwres_AdcGroup, "TRG", "reqtr0", MF_is_exttrig, MF_is_exttrig)

		//-------------------	CHANNEL SETTINGS TAB									 -------------------//
		//-------------------	CHANNELS VISIBILITY BASED ON REQUIRED NUMBER OF CHANNELS -------------------//		
		gstring_Channel00Name.visible		= MF_CH00_Enabled;
		gstring_Channel01Name.visible		= MF_CH01_Enabled;
		gstring_Channel02Name.visible		= MF_CH02_Enabled;
		gstring_Channel03Name.visible		= MF_CH03_Enabled;
		gstring_Channel04Name.visible		= MF_CH04_Enabled;
		gstring_Channel05Name.visible		= MF_CH05_Enabled;
		gstring_Channel06Name.visible		= MF_CH06_Enabled;
		gstring_Channel07Name.visible		= MF_CH07_Enabled;
		gstring_Channel08Name.visible		= MF_CH08_Enabled;
		gstring_Channel09Name.visible		= MF_CH09_Enabled;
		gstring_Channel10Name.visible		= MF_CH10_Enabled;
		gstring_Channel11Name.visible		= MF_CH11_Enabled;
		gstring_Channel12Name.visible		= MF_CH12_Enabled;
		gstring_Channel13Name.visible		= MF_CH13_Enabled;
		gstring_Channel14Name.visible		= MF_CH14_Enabled;
		gstring_Channel15Name.visible		= MF_CH15_Enabled;

		glabel_ch0.visible					= MF_CH00_Enabled;
		glabel_ch1.visible					= MF_CH01_Enabled;
		glabel_ch2.visible					= MF_CH02_Enabled;
		glabel_ch3.visible					= MF_CH03_Enabled;
		glabel_ch4.visible					= MF_CH04_Enabled;
		glabel_ch5.visible					= MF_CH05_Enabled;
		glabel_ch6.visible					= MF_CH06_Enabled;
		glabel_ch7.visible					= MF_CH07_Enabled;
		glabel_ch8.visible					= MF_CH08_Enabled;
		glabel_ch9.visible					= MF_CH09_Enabled;
		glabel_ch10.visible					= MF_CH10_Enabled;
		glabel_ch11.visible					= MF_CH11_Enabled;
		glabel_ch12.visible					= MF_CH12_Enabled;
		glabel_ch13.visible					= MF_CH13_Enabled;
		glabel_ch14.visible					= MF_CH14_Enabled;
		glabel_ch15.visible					= MF_CH15_Enabled;

		gcheck_Channel00WfrEnabled.visible	= MF_CH00_Enabled;
		gcheck_Channel01WfrEnabled.visible	= MF_CH01_Enabled;
		gcheck_Channel02WfrEnabled.visible	= MF_CH02_Enabled;
		gcheck_Channel03WfrEnabled.visible	= MF_CH03_Enabled;
		gcheck_Channel04WfrEnabled.visible	= MF_CH04_Enabled;
		gcheck_Channel05WfrEnabled.visible	= MF_CH05_Enabled;
		gcheck_Channel06WfrEnabled.visible	= MF_CH06_Enabled;
		gcheck_Channel07WfrEnabled.visible	= MF_CH07_Enabled;
		gcheck_Channel08WfrEnabled.visible	= MF_CH08_Enabled;
		gcheck_Channel09WfrEnabled.visible	= MF_CH09_Enabled;
		gcheck_Channel10WfrEnabled.visible	= MF_CH10_Enabled;
		gcheck_Channel11WfrEnabled.visible	= MF_CH11_Enabled;
		gcheck_Channel12WfrEnabled.visible	= MF_CH12_Enabled;
		gcheck_Channel13WfrEnabled.visible	= MF_CH13_Enabled;
		gcheck_Channel14WfrEnabled.visible	= MF_CH14_Enabled;
		gcheck_Channel15WfrEnabled.visible	= MF_CH15_Enabled;

		gcombo_EventGenerationChannel00.visible	= MF_CH00_Enabled;
		gcombo_EventGenerationChannel01.visible	= MF_CH01_Enabled;
		gcombo_EventGenerationChannel02.visible	= MF_CH02_Enabled;
		gcombo_EventGenerationChannel03.visible	= MF_CH03_Enabled;
		gcombo_EventGenerationChannel04.visible	= MF_CH04_Enabled;
		gcombo_EventGenerationChannel05.visible	= MF_CH05_Enabled;
		gcombo_EventGenerationChannel06.visible	= MF_CH06_Enabled;
		gcombo_EventGenerationChannel07.visible	= MF_CH07_Enabled;
		gcombo_EventGenerationChannel08.visible	= MF_CH08_Enabled;
		gcombo_EventGenerationChannel09.visible	= MF_CH09_Enabled;
		gcombo_EventGenerationChannel10.visible	= MF_CH10_Enabled;
		gcombo_EventGenerationChannel11.visible	= MF_CH11_Enabled;
		gcombo_EventGenerationChannel12.visible	= MF_CH12_Enabled;
		gcombo_EventGenerationChannel13.visible	= MF_CH13_Enabled;
		gcombo_EventGenerationChannel14.visible	= MF_CH14_Enabled;
		gcombo_EventGenerationChannel15.visible	= MF_CH15_Enabled;


		// Toggle message fields if names are invalid or not unique
		gmessage_errorinfo.text = MF_errorinfo_string;
		gmessage_errorinfo.visible = MF({gmessage_errorinfo.text != ""}, Boolean)

	}
	/* End   : APP Constructor */

	/* Begin : File Generation */
	def generateFiles()
	{
		generate("analog_converter_evadc_confh.tmpl", "analog_converter_evadc_conf.h", false);
		generate("analog_converter_evadc_confc.tmpl", "analog_converter_evadc_conf.c", false);
		copy("analog_converter_evadc.c", "analog_converter_evadc.c");
		copy("analog_converter_evadc.h", "analog_converter_evadc.h");
	}
	/* End   : File Generation */

	def debug(text, level) {
		if (IsDebugVersion)
		{
			println("DEBUG: ${text}", level);
		}
	}
}
