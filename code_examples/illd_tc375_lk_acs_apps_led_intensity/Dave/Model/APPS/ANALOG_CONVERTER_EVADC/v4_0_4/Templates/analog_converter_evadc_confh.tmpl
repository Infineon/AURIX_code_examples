		protected ReqiuredApp(Builder builder)
		{
			this.mName = builder.mName
			this.mDisplayName = builder.mDisplayName
			this.mMinVersion = builder.mMinVersion
			this.mIsRequired = builder.mIsRequired ?: false
			this.mInstanceLabel = builder.mInstanceLabel
		}

