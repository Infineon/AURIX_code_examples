	/**
	 * A Class to represent an ADC Channel based on Manifest/GUI data
	 */
	class AdcChannel {
		Integer mGroupId = -1;
		Integer mChannelId = -1;
		Integer mPhysicalCh = -1;
		Integer mPort = -1;
		Integer mPad = -1;
		String mCustomName = "";
		String mEvent = "";
		Boolean mWaitForRead = false;


		// This set contains a unique list of requiredapps that have something to do with this specific channel
		private Set<ReqiuredApp> mRequiredAppSet = null;

		AdcChannel(groupId, channelId, physicalCh, port, pad, customName, event, waitForRead = false) {
			this.mGroupId = groupId;
			this.mChannelId = channelId;
			this.mPhysicalCh = physicalCh;
			this.mPort = port;
			this.mPad = pad;
			this.mCustomName = customName;
			this.mEvent = event;
			this.mWaitForRead = waitForRead;

			mRequiredAppSet = new HashSet</*ReqiuredApp*/>(); // To make sure we only add unique objects and no duplicates
		}

		Boolean addRequiredApp(ReqiuredApp reqApp)
		{
			return mRequiredAppSet.add(reqApp);
		}

		def getRequiredApps()
		{
			return mRequiredAppSet;
		}

		private def getExceptionMessage(String msg = "Has an error!")
		{
			return "EVADC Group ${getGroupId()} Channel #${getChannelId()} channel ${msg}.";
		}

		/** Check if this ADC Channel is correctly constructed */
		def isValid() {
			return mGroupId > -1 && mChannelId > -1;
		}

		/** Get group number */
		def	getGroupId() {
			return this.mGroupId;
		}

		/** Get ID of this ADC channel (order to be converted) */
		def	getChannelId() {
			return this.mChannelId;
		}

		/** Get physical channel number */
		def	getPhysicalCh() {
			return this.mPhysicalCh;
		}

		/**
		 * Get ID of this ADC channel (channel number).
		 * @return Channel ID
		 */
		def	getId() {
			return this.mChannelId;
		}

		def getPort() {
			return this.mPort;
		}

		def getPin() {
			return this.mPad;
		}

		/** Get the custom user assigned name*/
		def	getCustomName() {
			return this.mCustomName;
		}

		def hasEvent() {
			return (this.mEvent != "None");
		}

		def getDebugLine() {
			return "EVADC Channel ${mChannelId} of Group ${mGroupId}" +
					" Custom Name: ${mCustomName}" +
					" Event generation: ${mEvent}";
		}

		/**
		 * This function will return appropriate ILLD enum based on WaitForRead checkbox
		 * IfxEvadc_WaitForRead_enabled || IfxEvadc_WaitForRead_overwriteMode
		 * @return
		 */
		def getWaitForReadEnum() {
			return (mWaitForRead ? "IfxEvadc_WaitForRead_enabled" : "IfxEvadc_WaitForRead_overwriteMode");
		}

		/**
		 * Get preprocessor custom name of this channel (prefixed with group ID to be unique)
		 * @return
		 */
		def getPpCustomName() {
			return "EVADC_G${mGroupId}_${this.getCustomName()}";
		}

		def getChannelConfigVarName() {
			return "EVADC_G${mGroupId}_${this.getCustomName()}_ChannelConfig";
		}

		def getChannelHandleVarName() {
			return "EVADC_G${mGroupId}_${this.getCustomName()}_ChannelHandle";
		}

		def getChannelResultVarName() {
			return "EVADC_G${mGroupId}_${this.getCustomName()}_ChannelResult";
		}

		def getChannelPinConfigVarName() {
			return "EVADC_G${mGroupId}_${this.getCustomName()}_ChannelPinConfig";
		}

		def getIsrFuncName() { // Interrupt service routine name for this channel
			if(this.hasEvent()) {
				// We prefixed this in manifest with EVADC_Gx_
				// And post fixed with _ISR so we have to do the same when generating the code
				return "EVADC_G${getGroupId()}_${getCustomName()}_ISR"
			} else {
				throw new Exception(getExceptionMessage("has INTERRUPT_CONFIG APP associated with it!" +
				" Please enable Events in the Channels tab." ));
			}
		}
	}

	/**
	 * Object representing an ADC Group
	 */
	class AdcGroup {

		/** ID Of ADC group */
		private Integer 	mGroupId = -1;

		private String		mAppLabel = null;

		private Float		mSampleTime = 1; // Sample time in microseconds

		private Integer		mExtTrig = 0; // Index of External Trigger param on GUI

		private Integer		mXTSEL = 0; // External Trigger Input Selection (QCTRL0.XTSEL)

		private Integer		mGTSEL = 0; // External Gate Input Selection (QCTRL0.GTSEL)

		private List<AdcChannel> mChannels = null;
		
		private String		mAutoStartConversion; // Start conversion after init

		/**
		 * Construct an AdcGroup obeject with id and number of enabled channels
		 */
		AdcGroup(Integer groupId, String appLabel, Float sampleTime, Integer extTrig, Integer xtSel, Integer gtSel) {
			this.mGroupId = groupId;

			mSampleTime = sampleTime;

			mExtTrig = extTrig;

			mXTSEL = xtSel;

			mGTSEL = gtSel;

			mAppLabel = appLabel;

			mChannels = []; // Init the list
			
			mAutoStartConversion = "false";
		}

		def getSampleTimeString() {
			return "${mSampleTime.round(1)}e-6"; // Round necessary to disallow numbers like 1.3216546878468465421651 !!!!
		}
		
		def getExtTriggerIndex() {
			return mExtTrig;
		}

		def getExtTrigString() {
			String str = "IfxEvadc_TriggerMode_"
			if (mExtTrig == 0)
			{
				str += "noExternalTrigger"
			}
			else if (mExtTrig == 1)
			{
				str += "uponFallingEdge"
			}
			else if (mExtTrig == 2)
			{
				str += "uponRisingEdge"
			}
			else
			{
				str += "uponAnyEdge"
			}
			return str
		}

		def getXtselString() {
			return "IfxEvadc_TriggerSource_" + mXTSEL.toString();
		}

		def getGtselString() {
			return "IfxEvadc_GatingSource_" + mGTSEL.toString();
		}

		def getInstanceLabel() {
			return mAppLabel;
		}

		def getAppLabel() {
			return getInstanceLabel();
		}

		def hasEventOnChannels() {
			for (AdcChannel ch in mChannels)
			{
				if (ch.hasEvent())
				{
					return true;
				}
			}
			return false;
		}

		/**
		 * Get ID of group
		 * @return ID of group
		 */
		def getId() {
			return mGroupId;
		}

		/**
		 * Get Id of group (alias for @see{getId()}
		 * @return ID of group
		 */
		def getGroupId() {
			return mGroupId;
		}

		/**
		 * Add a channel to this group
		 * @param channel Channel object
		 * @return No return
		 */
		def addChannel(channel) {
			mChannels.add(channel);
		}

		/**
		 * Get number of enabled channels for this ADC group
		 * @return number of channels
		 */
		def getNumberOfChannels() {
			return mChannels.size();
		}

		/**
		 * Get a string representation of content of this group
		 * @return string
		 */
		def getDebugLine() {
			return "EVADC Group #${groupId}, Number of enabled channels: ${mChannels.size()}";
		}

		/**
		 * Get list of enabled channels for this ADC group
		 * @return list of channels
		 */
		List<AdcChannel> getChannels() {
			return this.mChannels;
		}

		/**
		 * Get preprocessor for group ID
		 * @return
		 */
		def getPpId() {
			return "EVADC_G${mGroupId}";
		}

		/**
		 * Get preprocessor for number of channels
		 * @return
		 */
		def getPpChannelsNum() {
			return "${getPpId()}_NUM_CHANNELS";
		}

		/**
		 * Get global variable for this group
		 * @return
		 */
		def getGlobVarGroup() {
			return "g_evadcGroup_${mGroupId}";
		}

		/**
		 * Get global variable for this group's result storage
		 */
		def getGlobalVarResults() {
			return "${getGlobVarGroup()}_Results";
		}

		/**
		 * Get global variable name for this group's channels
		 * @return
		 */
		def getGlobVarChannels() {
			return "${getGlobVarGroup()}_Channels";
		}

		/**
		 * Get the config struct name for this instance. Usually the same as app label!
		 * @return
		 */
		def getInstanceStruct() {
			return mAppLabel;
		}

		def getGroupConfigVarName() {
			return "ANALOG_CONVERTER_EVADC_GROUP_${mGroupId}_Config";
		}

		// This is the same for all apps
		def getEvadcModuleConfigVarName() {
			return "ANALOG_CONVERTER_EVADC_ModuleConfig";
		}
		
		def setAutoStart(String autoStart) {
			
			mAutoStartConversion = autoStart;
		}
		
		def getAutoStartConversion() {
			return mAutoStartConversion;
		}
		
		def getAutoStartConversionAsBoolean() {
			mAutoStartConversion == "true" ? true : false;
		}
	}

	/**
	 * Object to contain all instances of APP
	 */
	class AppInstance
	{
		ANALOG_CONVERTER_EVADC instance = null;
		String name = "";
		List<String> uri = null;
		AdcGroup group = null;

		def getAppConfStruct() {
			return name + "_Config";
		}
	}

	/**
	 * Will contain all information from all instances
	 */
	List<AppInstance> appInstances = [];

	// Go over all APP Instances and create ADC Groups and add ADC Channels to each group
	for (ANALOG_CONVERTER_EVADC appInst : appInstancesList)
	{
		appLabel = appInst.getInstanceLabel(); // Name of current instance in itteration
		evadc_uri = appInst.hwres_AdcGroup.getSolverUri(); // URI of peripheral/group for this instance
		if (ANALOG_CONVERTER_EVADC.IsDebugVersion)
		{
			println("/****    DEBUG INSTANCE ${appLabel}")

			for (var in evadc_uri)
			{
				out.print("""
                        URI Sections: ${var}
                        """);
			}

			// Pad00
			println("hwres_port00 getSolverUri");
			for (var in appInst.hwres_port_00.getSolverUri())
			{
				println("hwres_port_00 URI Sections: ${var}");
			}

			// Pin00
			println("PIN 00 getSolverUri");
			println("displayName ${appInst.vs_port_pad_00.displayName.value}");
			println("hwSignalName ${appInst.vs_port_pad_00.hwSignalName}");
			println("hwSignalName ${appInst.vs_port_pad_00.resourceGroup.resourceGroupUri}");

			appInst.vs_port_pad_00.solverMap.each{k, v -> println "\n${k}:${v}"}

			println("****/")
		}

		/* If the channel resource is available */
		if (evadc_uri != null)
		{
			// Find out which group was assigned to this ADC group by solver
			groupNum = evadc_uri[6] as Integer;

			def xtsel;
			xtsel = appInst.hwres_AdcGroup.getRegisterValue("qctrl0", "xtsel");
			if (xtsel == null)
			{
				xtsel = appInst.hwres_AdcGroup.getRegisterValue("g" + evadc_uri[6] + "qctrl0", "xtsel");
			}
			exttrig = appInst.gcombo_TriggerEdge.options.indexOf(appInst.gcombo_TriggerEdge.value);
			if (!exttrig || (xtsel == null))
			{
				xtsel = 0;
			}
			else
			{
				xtsel = xtsel.toInteger();
			}

			def gtsel;
			gtsel = appInst.hwres_AdcGroup.getRegisterValue("qctrl0", "gtsel");
			if (gtsel == null)
			{
				gtsel = appInst.hwres_AdcGroup.getRegisterValue("g" + evadc_uri[6] + "qctrl0", "gtsel");
			}
			if (!exttrig || (gtsel == null))
			{
				gtsel = 0;
			}
			else
			{
				gtsel = gtsel.toInteger();
			}

			// Create group object
			adcGroup = new AdcGroup(groupNum, appLabel, (Float)appInst.gfloat_SampleTime.value, exttrig, xtsel, gtsel);
			adcGroup.setAutoStart(appInst.gstring_autoStart.value);


			/*** Go over channel related stuff from GUI and create channel instances ***/
			// Channel 00
			if (appInst.ginteger_NumChannels.value > 0)
			{
				AdcChannel ch00 = new AdcChannel(groupNum, 0,
						appInst.sv_sigch_name_00.getSolverValue().find(/\d+/).toInteger(),
						(appInst.hwres_port_00.getSolverUri()[3] == "p") ? appInst.hwres_port_00.getSolverUri()[4].toInteger() : -1,
						appInst.hwres_port_00.getSolverUri()[6].toInteger(),
						appInst.gstring_Channel00Name.value,
						appInst.gcombo_EventGenerationChannel00.value,
						appInst.gcheck_Channel00WfrEnabled.value);
			
				// Add InterruptConfig app which is intended for channel 00
				InterruptConfigApp icfgApp00 = new InterruptConfigApp.Builder()
						.mName(appInst.appres_icfg00.getAppName())
						.mDisplayName(appInst.appres_icfg00.getDisplayName())
						.mMinVersion(appInst.appres_icfg00.getMinVersion())
						.mIsRequired(appInst.appres_icfg00.getIsApprequired())
						.mInstanceLabel(appInst.appres_icfg00.getInstanceLabel())
						.build();
			
				ch00.addRequiredApp(icfgApp00);
				adcGroup.addChannel(ch00);
			}
			
			// Channel 01
			if (appInst.ginteger_NumChannels.value > 1)
			{
				AdcChannel ch01 = new AdcChannel(groupNum, 1,
						appInst.sv_sigch_name_01.getSolverValue().find(/\d+/).toInteger(),
						(appInst.hwres_port_01.getSolverUri()[3] == "p") ? appInst.hwres_port_01.getSolverUri()[4].toInteger() : -1,
						appInst.hwres_port_01.getSolverUri()[6].toInteger(),
						appInst.gstring_Channel01Name.value,
						appInst.gcombo_EventGenerationChannel01.value,
						appInst.gcheck_Channel01WfrEnabled.value);
			
				// Add InterruptConfig app which is intended for channel 01
				InterruptConfigApp icfgApp01 = new InterruptConfigApp.Builder()
						.mName(appInst.appres_icfg01.getAppName())
						.mDisplayName(appInst.appres_icfg01.getDisplayName())
						.mMinVersion(appInst.appres_icfg01.getMinVersion())
						.mIsRequired(appInst.appres_icfg01.getIsApprequired())
						.mInstanceLabel(appInst.appres_icfg01.getInstanceLabel())
						.build();
			
				ch01.addRequiredApp(icfgApp01);
				adcGroup.addChannel(ch01);
			}
			
			// Channel 02
			if (appInst.ginteger_NumChannels.value > 2)
			{
				AdcChannel ch02 = new AdcChannel(groupNum, 2,
						appInst.sv_sigch_name_02.getSolverValue().find(/\d+/).toInteger(),
						(appInst.hwres_port_02.getSolverUri()[3] == "p") ? appInst.hwres_port_02.getSolverUri()[4].toInteger() : -1,
						appInst.hwres_port_02.getSolverUri()[6].toInteger(),
						appInst.gstring_Channel02Name.value,
						appInst.gcombo_EventGenerationChannel02.value,
						appInst.gcheck_Channel02WfrEnabled.value);
			
				// Add InterruptConfig app which is intended for channel 02
				InterruptConfigApp icfgApp02 = new InterruptConfigApp.Builder()
						.mName(appInst.appres_icfg02.getAppName())
						.mDisplayName(appInst.appres_icfg02.getDisplayName())
						.mMinVersion(appInst.appres_icfg02.getMinVersion())
						.mIsRequired(appInst.appres_icfg02.getIsApprequired())
						.mInstanceLabel(appInst.appres_icfg02.getInstanceLabel())
						.build();
			
				ch02.addRequiredApp(icfgApp02);
				adcGroup.addChannel(ch02);
			}
			
			// Channel 03
			if (appInst.ginteger_NumChannels.value > 3)
			{
				AdcChannel ch03 = new AdcChannel(groupNum, 3,
						appInst.sv_sigch_name_03.getSolverValue().find(/\d+/).toInteger(),
						(appInst.hwres_port_03.getSolverUri()[3] == "p") ? appInst.hwres_port_03.getSolverUri()[4].toInteger() : -1,
						appInst.hwres_port_03.getSolverUri()[6].toInteger(),
						appInst.gstring_Channel03Name.value,
