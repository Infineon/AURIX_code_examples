	/* Class to generate a formatted macro line */
	@groovy.transform.builder.Builder
	class MacroGen {
		def lhs;
		def rhs;
		def comment;

		@Override
		String toString() {


			if ((comment.toString().size() + rhs.toString().size()) < (27 + 26))
			{ // All fit in single line
				return String.format("#define %-27s %-26s /* %-49s */",
						lhs, rhs, comment);
			}
			else
			{ // Put comment on top
				return String.format("/* %-49s */\n#define %-27s %-26s",
						lhs, rhs, comment);
			}
		}
	}

	/**
	 * Class to generate a formatted variable declaration/definition line
	 */
	@groovy.transform.builder.Builder
	class VarGen {
		def lhs;
		def rhs;
		def comment;
		def isDecel; // with true, there will be no assignement operator between lhs and rhs

		@Override
		String toString() {
			if (isDecel)
			{ // Declaration
				String format = (lhs.toString().size() + rhs.toString().size()) > (25 + 27)
						? "%-25s %-27s /* %-60s */"  // Single line
						: "/* %-113s */\n%-50s %-115s"; // Comment above the line
				return String.format(format,
						lhs, rhs + ";", comment);
			} else { // Definition, we add assignment sign
				String format = (lhs.toString().size() + rhs.toString().size()) > (25 + 25)
						? "%-25s = %-27s /* %-60s */"  // Single line
						: "/* %-113s */\n%-50s =  %-112s"; // Comment above the line
				return String.format(format,
						lhs, rhs + ";", comment);
			}
		}
	}

