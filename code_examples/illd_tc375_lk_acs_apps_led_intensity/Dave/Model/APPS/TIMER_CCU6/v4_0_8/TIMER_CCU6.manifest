package Model.APPS.TIMER_CCU6.v4_0_8;
/*************** Revision History **********************************************
 Version      Date          Description
 4.0.2        12-Sep-2025   - Initial version
 4.0.4        15-Sep-2025   - License and Copyright update
 4.0.6		  24-Oct-2025	- Change Actual Interval and Max Interval display format
 4.0.8        30-Jan-2026   - Quality update
 *******************************************************************************/

 import ifx.davex.app.manifest.*

class  TIMER_CCU6 extends TIMER_CCU6_GUI
{
	/* Note  : Following APP properties are mandatory and important */

	/* Begin : APP property section */

	/**
	 * APP version
	 * Format: a string with three digit separated by a dot.
	 */
	def version            = '4.0.8'

	/**
	 * APP categories declaration.
	 * It is list of strings. Subcategories are separated by slash.
	 * No limits on number of categories and subcategories depth.
	 */
	def categoriesDescription = ["Timer"]

	/**
	 * Minimum DAVE version required for this APP.
	 *
	 * It is string with three digit separated by a dot.
	 */
	def minDaveVersion           = '4.2.4'

	/**
	 * Keywords used by search feature in APPs selection view
	 *
	 * It is a list of string.
	 */
	def keywords      = ['CCU6', 'Timer']

	/**
	 * softwareIDs is used to declare which devices are compatible with this APP.
	 * It is a map with key a string containing a pattern that shall match the SW id of
	 * the device and as value the minimal version of the APP.
	 */

	def softwareIDs       = [
        "TC3.*.*.*":"1.0.0"]

	/**
	 * Singleton property:
	 * When it is true the APP can be instantiated only once.
	 */
	def singleton     = false


	/**
	 * initProvider property
	 * It shall be true to add a call to <AppName>_Init()
	 */
	def initProvider  = true

	/**
	 * Deprecated APP
	 * Set it to true to indicate that the APP shall be not used for new projects.
	 */
	def deprecated    = false

	/**
	 * Sharable property.
	 * It shall be true to allows multiple APPs to require the same instance of this APP.
	 */
	def sharable      = false

	/**
	 *  APP function description.
	 */
	def description = "Provides an accurate timer by using hardware CCU6 timer. This can be used as a trigger input to other peripherals or to create an event"

	/* End   : APP property section */

	/* Begin : User APP property section */
	MRequiredApp appres_clock							// CLOCK APP
	MRequiredApp appres_ccu6_generic					// CCU_GENERIC APP
	MVirtualResourceGroup hwres_CCU6_CCU6x_Timer		// CCU6 resource
	MVirtualSignal vs_timer_ccu6_period_match_interrupt	// Period match interrupt
	SolverVariable sv_timer_no = SolverVariable()		// SolverVariable to store Timer#
	SolverVariable sv_pmintr_name = SolverVariable()	// SolverVariable to store interrupt signal name
	GFloat gfloat_timer_clock_mhz = GFloat();			// This holds input clock frequency to the CCU Timer.
	GInteger ginteger_timer_prescaler  = GInteger();	// This holds the prescaler value calculated. Used during code generation in templates.
	GInteger ginteger_timer_period_reg = GInteger();	// This holds the period register value calculated. Used during code generation in templates.
	GInteger ginteger_timer_freq = GInteger();			// Frequency related to the time interval chosen.
	/* End   : User APP property section */

	/**
	 *  Calculates the resolution of the timer in micro seconds interval
	 *  Inputs :  clock     - clock frequency supplied to the module in MHz
	 *            prescaler - Timer Prescaler value
	 */
	Double timer_resolution(Double clock, Double prescaler) {
		Double actual_resolution =  ((1 /clock) * 2.power(prescaler)); /*(1 << prescaler.value); */
		actual_resolution
	}

	/**
	 *  Calculates the frequency of the timer in MHz interval once applied the prescaler
	 *  Inputs :  clock     - clock frequency supplied to the module in MHz
	 *            prescaler - Timer Prescaler value
	 */
	Double timer_period(Double clock, Double prescaler) {
		Double actual_freq =  (clock / 2.power(prescaler)); /*(1 << prescaler.value); */
		actual_freq
	}

	/* Begin : APP Constructor */
	public TIMER_CCU6(DaveEnv daveEnv)
	{
		//MF is_T12      = MF({return(gcombo_hwresource.value == "T12")}, Boolean)
		//MF is_T13      = MF({return(gcombo_hwresource.value == "T13")}, Boolean)
		MF is_intr = MF({return(gcheck_tinteventen.value == true)}, Boolean)
		//MF is_T13_intr = MF({return(gcombo_hwresource.value == "T13" && gcheck_tinteventen.value == true)}, Boolean)

		/* ----------------------------------------------------------------------------------------------------------------------------------------- */
		/* -------------------------------- Hardware resource consumption block -------------------------------------------------------------------- */
		/* ----------------------------------------------------------------------------------------------------------------------------------------- */
		addUriElementRangeConstraint(sv_timer_no, ["t12", "t13"])
		hwres_CCU6_CCU6x_Timer = MVirtualResourceGroup("Timer Channel", ["peripheral", "ccu6", "0", "*", sv_timer_no], true)
		

		/* ----------------------------------------------------------------------------------------------------------------------------------------- */
		/* -------------------------------- APP IO Signals ----------------------------------------------------------------------------------------- */
		/* ----------------------------------------------------------------------------------------------------------------------------------------- */
		
		addIfAndOnlyIfConstraint(uriElementRangeConstraint(sv_timer_no, ["t12"]), uriElementRangeConstraint(sv_pmintr_name, ["t12pm"]))
		addIfAndOnlyIfConstraint(uriElementRangeConstraint(sv_timer_no, ["t13"]), uriElementRangeConstraint(sv_pmintr_name, ["t13pm"]))
		
		vs_timer_ccu6_period_match_interrupt = MVirtualSignal(hwres_CCU6_CCU6x_Timer, "INT", sv_pmintr_name, is_intr, is_intr)
		

		/* ----------------------------------------------------------------------------------------------------------------------------------------- */
		/* -------------------------------- Required APP ------------------------------------------------------------------------------------------- */
		/* ----------------------------------------------------------------------------------------------------------------------------------------- */
		appres_clock = MRequiredApp("CLOCK", "CLOCK APP", RSHARABLE, "4.0.2")
		appres_ccu6_generic = MRequiredApp("CCU6_GENERIC", "CCU6_GENERIC APP", RSHARABLE, "4.0.2")

		/* ----------------------------------------------------------------------------------------------------------------------------------------- */
		/* -------------------------------- APP Configuration -------------------------------------------------------------------------------------- */
		/* ----------------------------------------------------------------------------------------------------------------------------------------- */
		final Integer period_16bit_maxvalue  = (2.power(16)-1); /* Maximum supported period register value */
		final Integer prescaler_maxvalue     = 15               /* Maximum supported prescaler value */
		final Integer prescaler_minvalue     = 0                /* Least supported prescaler value */

		gfloat_timer_clock_mhz.value = MF({return(appres_clock.getVal(["gfloat_fSPB", "value"]))}, Float) // Maybe move this value in CCU6 config APP

		/*
		 * Supported minimum time interval based on the input clock frequency.
		 */
		gfloat_time_interval.minValue = MF(
		{
			Float res_max = (float)(timer_resolution(gfloat_timer_clock_mhz.value, prescaler_minvalue).round(2))
			return res_max
		}, Float)

		/*
		 * Supported maximum time interval based on the input clock frequency.
		 */
		gfloat_time_interval.maxValue = MF(
		{
			Float res_max = (float)((timer_resolution(gfloat_timer_clock_mhz.value, prescaler_maxvalue) * period_16bit_maxvalue).round(2))
			return res_max
		}, Float)

		/*
		 * Based on the input clock frequency and input time interval least possible prescaler is calculated. So that error is less.
		 * This value is used during code generation in templates.
		 */
		ginteger_timer_prescaler.value = MF(
		{
			Integer prescaler = 0
			Double Clock_Period_min = 0
			Double Clock_Period_max = 0
			for (prescaler = prescaler_minvalue; prescaler <= prescaler_maxvalue; prescaler++)
			{
				Clock_Period_min = timer_resolution(gfloat_timer_clock_mhz.value, prescaler);	/* convert to usec */
				Clock_Period_max = Clock_Period_min * period_16bit_maxvalue;			/* convert to usec */
				if (gfloat_time_interval.value <= Clock_Period_max)
				{
					break;
				}
			}
			if (prescaler > prescaler_maxvalue)
			{
				prescaler = -1;
			}
			return prescaler
		}, Integer);

		/*
		 * Period register value for the selected time interval value.
		 * This value is used during code generation in templates.
		 */
		ginteger_timer_period_reg.value = MF(
		{
			Integer period_val = (Integer)(((Double)gfloat_time_interval.value).round(2)
													* timer_period((Double)gfloat_timer_clock_mhz.value, (Double)ginteger_timer_prescaler.value))
			if (period_val > 1)
			{
				period_val--;
			}
			return period_val
		}, Integer);	/* Tper= <Period-Value> + 1; in ftclk */

		/*
		 * Frequency value for the selected time interval value.
		 * This value is used during code generation in templates.
		 */
		ginteger_timer_freq.value = MF(
		{
			Integer freq_val = (Integer)1000000 * (1 / timer_resolution((Double)gfloat_timer_clock_mhz.value, (Double)ginteger_timer_prescaler.value));
			return freq_val
		}, Integer);

		gstring_info.value = MF(
		{
			double r = timer_resolution((Double)gfloat_timer_clock_mhz.value, (Double)ginteger_timer_prescaler.value).round(2)
			double p = ((double)(ginteger_timer_period_reg.value + 1) * r / 1000000).round(6)
			double m = (timer_resolution((Double)gfloat_timer_clock_mhz.value, (Double)ginteger_timer_prescaler.value) * period_16bit_maxvalue / 1000000).round(6)
			return (String.format("%.2f", r) + " / " + String.format("%.6f", p) + " / " + String.format("%.6f", m))
		}, String)
	}
	/* End   : APP Constructor */

	/* Begin : File Generation */
	def generateFiles()
	{
		generate("timer_ccu6_confh.tmpl", "timer_ccu6_conf.h")
		generate("timer_ccu6_confc.tmpl", "timer_ccu6_conf.c")
		copy("timer_ccu6.c", "timer_ccu6.c")
		copy("timer_ccu6.h", "timer_ccu6.h")
	}
	/* End : File Generation */
}
